{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "OpenGeni",
  "description": "Add agents that finish real work to your product. OpenGeni is the open, self-hostable runtime for long-running AI agents.",
  "colors": {
    "primary": "#1f8a74",
    "light": "#9fe3d3",
    "dark": "#1f8a74"
  },
  "background": {
    "color": {
      "light": "#fbfbf8",
      "dark": "#0f1115"
    }
  },
  "fonts": {
    "heading": {
      "family": "DM Sans",
      "weight": 500
    },
    "body": {
      "family": "DM Sans"
    }
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://opengeni.ai"
  },
  "navigation": {
    "groups": [
      {
        "group": "Get started",
        "pages": ["index", "embed-with-a-coding-agent", "embed-manually", "quickstart"]
      },
      {
        "group": "Build",
        "pages": [
          "integrate/how-it-fits-together",
          "integrate/conversation-ui",
          "integrate/configure-the-agent",
          "integrate/your-data",
          "integrate/background-agents",
          "integrate/users-and-tenants",
          "integrate/approvals-and-questions",
          "integrate/existing-chat-ui",
          "integrate/proxy-from-any-backend",
          "integrate/production",
          "integrate/session-history-import",
          "integrate/host-managed-integrations"
        ]
      },
      {
        "group": "Concepts",
        "pages": [
          "concepts/sessions",
          "concepts/goals",
          "concepts/approvals-and-human-input",
          "concepts/compute-targets",
          "concepts/memory-and-knowledge"
        ]
      },
      {
        "group": "Guides",
        "pages": [
          "guides/developer-plugin",
          "guides/self-host",
          "run-locally",
          "guides/connect-a-machine",
          "guides/webhooks-and-credentials",
          "guides/usage-allowances"
        ]
      },
      {
        "group": "Reference",
        "pages": [
          "reference/sdk",
          "reference/react",
          "reference/authentication",
          "reference/http-api",
          "reference/for-ai-agents",
          "reference/opengeni-client-skill"
        ]
      },
      {
        "group": "Examples",
        "pages": ["examples/northstar-support", "examples/chat-quickstart"]
      },
      {
        "group": "Further reading",
        "pages": ["reference/further-reading"]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "GitHub",
          "href": "https://github.com/Cloudgeni-ai/opengeni",
          "icon": "github"
        },
        {
          "anchor": "Open app",
          "href": "https://app.opengeni.ai",
          "icon": "arrow-up-right-from-square"
        }
      ]
    }
  },
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/Cloudgeni-ai/opengeni"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Open app",
      "href": "https://app.opengeni.ai"
    }
  },
  "contextual": {
    "options": ["copy", "view", "chatgpt", "claude", "perplexity", "mcp", "cursor", "vscode"]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/Cloudgeni-ai/opengeni"
    }
  },
  "redirects": [
    {
      "source": "/guides/integrate-your-product",
      "destination": "/embed-manually"
    }
  ]
}
