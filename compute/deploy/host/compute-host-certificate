#!/usr/bin/env bash
# Gets this host its certificate from the control service, which is the
# hosts' certificate authority, and renews it when fewer than four days of
# its week are left. A new certificate restarts the agent to use it (its VMs
# keep running). install.sh installs it and runs it before the agent starts;
# compute-host-certificate.timer runs it daily.
#
#   compute-host-certificate [--force] [--config FILE]
#
#   --force         renew even if the certificate has days left
#   --config FILE   the host's configuration (default /etc/compute/host.env)
#
# How the host proves which host it is:
#   - on Google Cloud (the metadata server answers), with an instance
#     identity token for COMPUTE_CONTROL: the certificate is for the
#     instance's own name, so a host whose certificate expired gets a new one
#     all the same;
#   - elsewhere, with its current certificate: a new one for the same name;
#   - a host off Google Cloud that has none gets its first with
#     `compute-control issue-host-certificate`, run where the authority's key
#     is, for the request this script leaves at /etc/compute/request/host.csr;
#     the certificate goes back to /etc/compute/request/host.pem, and the
#     next run installs it.
#
# It trusts the service by /etc/compute/ca.pem, the hosts' authority, and
# replaces that with the authorities the service hands out, so a host
# follows the authority being replaced (operations.md, Keys and
# certificates).
#
# The key and the certificate are one unit: each pair is written to a
# directory of its own under certificates/, and the symlink `certificate`
# is switched to it in one rename; host.pem and host.key, the paths the
# agent is configured with, point through it. So an interrupted run leaves
# the old pair or the new one, never a key of one and the certificate of
# the other, and a pair counts as current only if the key is the
# certificate's and the certificate verifies against ca.pem. Runs are
# serialised by a lock.
#
# Every run first finishes what an interrupted one left: host.pem and
# host.key are pointed through `certificate` if that holds a valid pair
# and they do not (a run stopped between the two, as when moving from the
# old layout of plain files), and a restart the agent is owed is done. The
# file restart-owed is written, durably, before a pair is switched in, and
# removed only once the agent restarted (or was not running, so it starts
# with the new pair): a run that fails after the switch, in cleaning up or
# in the restart, leaves it for the next run.
set -euo pipefail

config=/etc/compute/host.env
force=
while [ $# -gt 0 ]; do
  case "$1" in
    --force) force=1; shift ;;
    --config) config=$2; shift 2 ;;
    *) echo "compute-host-certificate: unknown argument $1" >&2; exit 2 ;;
  esac
done
dir=${COMPUTE_CERTIFICATE_DIR:-/etc/compute}
metadata=${COMPUTE_METADATA_URL:-http://metadata.google.internal/computeMetadata/v1}
# Renewed with four of its seven days left.
renew_within=$((4 * 24 * 3600))

log() { echo "compute-host-certificate: $*"; }
fail() { echo "compute-host-certificate: $*" >&2; exit 1; }

# shellcheck source=host.env.example
source "$config"
: "${COMPUTE_CONTROL:?COMPUTE_CONTROL is not set in $config}"
: "${COMPUTE_NAME:?COMPUTE_NAME is not set in $config}"
[ -s "$dir/ca.pem" ] ||
  fail "$dir/ca.pem is missing: it holds the hosts' authority, ca.crt of the control service's hosts TLS Secret (install.sh --authority installs it)"
cd "$dir"
exec 9>"$dir/.certificate.lock"
flock 9

# Whether the key `$2` is the certificate `$1`'s, the certificate verifies
# against ca.pem, and it is valid for `$3` more seconds.
pair() {
  [ -s "$1" ] && [ -s "$2" ] &&
    [ "$(openssl x509 -in "$1" -noout -pubkey 2>/dev/null)" = "$(openssl pkey -in "$2" -pubout 2>/dev/null)" ] &&
    openssl verify -CAfile ca.pem "$1" >/dev/null 2>&1 &&
    openssl x509 -in "$1" -noout -checkend "${3:-0}" >/dev/null 2>&1
}
current() { pair host.pem host.key "${1:-0}"; }

# Points host.pem and host.key through `certificate`, each in one rename.
link_public() {
  local file
  for file in host.pem host.key; do
    if [ "$(readlink "$file" 2>/dev/null)" != "certificate/$file" ]; then
      ln -sfn "certificate/$file" "$file.new"
      mv -T "$file.new" "$file"
    fi
  done
}

# Restarts the agent if it runs, so it takes up the published pair, then
# clears the restart owed; a failed restart leaves it owed.
activate() {
  if systemctl is-active -q compute-host.service; then
    systemctl restart compute-host.service
  fi
  rm -f restart-owed
  sync . 2>/dev/null || sync
}

# Makes the pair in directory `$1` (host.pem, host.key) the host's, in one
# rename, and points host.pem and host.key through it.
publish() {
  local stamp
  stamp=$(date -u +%Y%m%dT%H%M%SZ).$$
  mkdir -p certificates
  chmod 700 certificates
  mkdir -m 700 "certificates/$stamp"
  cp -p "$1/host.key" "$1/host.pem" "certificates/$stamp/"
  chmod 600 "certificates/$stamp/host.key" "certificates/$stamp/host.pem"
  sync -f "certificates/$stamp/host.pem" 2>/dev/null || sync
  # Owed from before the switch until the agent restarted with the pair.
  : >restart-owed
  sync -f restart-owed 2>/dev/null || sync
  ln -sfn "certificates/$stamp" certificate.new
  mv -T certificate.new certificate
  link_public
  # Older pairs are no longer anyone's.
  for old in certificates/*; do
    [ "$old" = "certificates/$stamp" ] || rm -rf -- "$old"
  done
}

# What an interrupted run left: a published pair the public paths do not
# yet both point through, and a restart owed.
if [ -L certificate ] && pair certificate/host.pem certificate/host.key; then
  link_public
fi
if [ -e restart-owed ]; then
  log "restarting the agent for the certificate published before"
  activate
fi

# A first certificate an operator issued for the request left here.
if [ -s request/host.pem ] && pair request/host.pem request/host.key; then
  publish request
  rm -rf request
  log "installed the certificate issued for $COMPUTE_NAME, until $(openssl x509 -in host.pem -noout -enddate | cut -d= -f2)"
  activate
  exit 0
fi

if [ -z "$force" ] && current "$renew_within"; then
  exit 0
fi

on_gce=
if curl -fsS --max-time 3 -H Metadata-Flavor:Google "$metadata/instance/id" >/dev/null 2>&1; then
  on_gce=1
fi
if [ -n "$on_gce" ]; then
  token=$(curl -fsS --max-time 10 --retry 3 -H Metadata-Flavor:Google -G \
    --data-urlencode "audience=$COMPUTE_CONTROL" --data-urlencode format=full \
    "$metadata/instance/service-accounts/default/identity") ||
    fail "the metadata server gave no identity token for $COMPUTE_CONTROL"
  proof=$(jq -n --arg token "$token" '{kind: "gce_identity", token: $token}')
  client=()
  by="an instance identity token"
elif current; then
  proof='{"kind": "certificate"}'
  client=(--cert "$dir/host.pem" --key "$dir/host.key")
  by="its current certificate"
else
  if [ ! -s request/host.csr ] || [ ! -s request/host.key ]; then
    (umask 077 && mkdir -p request && openssl req -new -newkey ec -pkeyopt ec_paramgen_curve:P-256 -nodes \
      -keyout request/host.key -subj "/CN=$COMPUTE_NAME" -out request/host.csr 2>/dev/null)
  fi
  fail "no current certificate, and not on Google Cloud: get this host its first one where the authority's key is, with
  compute-control issue-host-certificate --name $COMPUTE_NAME --csr host.csr --authority <dir> > host.pem
copying $dir/request/host.csr there and the certificate back to $dir/request/host.pem, then run this again"
fi

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
(umask 077 && openssl req -new -newkey ec -pkeyopt ec_paramgen_curve:P-256 -nodes \
  -keyout "$work/host.key" -subj "/CN=$COMPUTE_NAME" -out "$work/host.csr" 2>/dev/null)
jq -n --rawfile csr "$work/host.csr" --argjson proof "$proof" '{csr: $csr, proof: $proof}' >"$work/asked.json"
if ! curl -sS --fail-with-body --max-time 30 --retry 3 --cacert "$dir/ca.pem" "${client[@]}" \
  -H 'content-type: application/json' --data-binary "@$work/asked.json" \
  -o "$work/answer.json" "${COMPUTE_CONTROL%/}/v1/hosts/certificate"; then
  fail "the control service at $COMPUTE_CONTROL issued no certificate: $(cat "$work/answer.json" 2>/dev/null)"
fi
name=$(jq -r .name "$work/answer.json")
[ "$name" = "$COMPUTE_NAME" ] ||
  fail "the service issued a certificate for $name, but this host is $COMPUTE_NAME (COMPUTE_NAME in $config)"
jq -r .certificate "$work/answer.json" >"$work/host.pem"
jq -r .authorities "$work/answer.json" >"$work/ca.pem"
# The certificate is the new key's, and of an authority the service trusts.
[ "$(openssl x509 -in "$work/host.pem" -noout -pubkey)" = "$(openssl pkey -in "$work/host.key" -pubout)" ] ||
  fail "the certificate the service issued is not for the key this host sent"
openssl verify -CAfile "$work/ca.pem" "$work/host.pem" >/dev/null ||
  fail "the certificate the service issued does not verify against the authorities it gave"

chmod 644 "$work/ca.pem"
# The authorities first: the new pair verifies against them, and the old
# one still does while an authority is being replaced (both are listed).
cmp -s "$work/ca.pem" ca.pem || mv "$work/ca.pem" ca.pem
publish "$work"
rm -rf request
log "a certificate for $name by $by, until $(openssl x509 -in host.pem -noout -enddate | cut -d= -f2)"
activate
