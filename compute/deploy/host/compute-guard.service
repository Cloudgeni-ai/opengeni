# The guard of a compute host in a fleet (ADR 18): it stops every VM when
# the host's lease runs out, whatever happens to the agent, and feeds the
# watchdog while it runs. If it ends, the watchdog resets the machine,
# which is what keeps a host that lost its lease from running sandboxes
# the fleet has already given to another host; so it is never restarted
# on failure. An upgrade hands it over: install.sh restarts it when it
# runs another binary. Stopping it closes the watchdog, which stays armed
# (nowayout) and is fed once more as it closes, so asked to stop the guard
# ends only at a step that may feed it: at once while the lease is valid,
# otherwise once the VMs have stopped (if they never do, the watchdog
# resets the machine, well before the stop times out). The new guard
# reopens it and goes on from what the lease file and the freezer show,
# as any guard starting does, well inside the watchdog's timeout.
# Installed by install.sh.
[Unit]
Description=Opengeni compute host guard: stops the VMs when the fleet lease ends
Documentation=https://github.com/Cloudgeni-ai/opengeni/blob/main/compute/docs/operations.md
After=local-fs.target compute-host-setup.service
Requires=compute-host-setup.service

[Service]
ExecStart=/opt/compute/current/compute-host guard
Restart=no
# The guard holds no memory worth reclaiming and must never be the one the
# kernel ends.
OOMScoreAdjust=-1000

[Install]
WantedBy=multi-user.target
