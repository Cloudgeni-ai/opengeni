# Server-side only. Never expose these values through a VITE_* variable.
OPENGENI_API_BASE_URL=https://app.opengeni.ai
OPENGENI_WORKSPACE_ID=replace_with_your_workspace_id
# An organization API key (see README for its permissions); workspace keys
# cannot act as the demo operator.
OPENGENI_API_KEY=ogk_replace_me

# Runs use the workspace's default model; the browser cannot choose one.
# Every run carries a $1.00 usage limit, so the Opengeni server must have
# per-task usage limits enabled (OPENGENI_SESSION_USAGE_LIMITS_ENABLED=true on
# its API and workers). Until then /api/demo/health answers 503.

# Shared only by Opengeni's encrypted per-session MCP credentials and this
# example backend. Generate a long random value.
OPENGENI_DEMO_MCP_TOKEN=replace_with_a_long_random_value

# Optional. Set to the public HTTPS origin or full /mcp URL. When omitted, the
# server auto-detects an ngrok tunnel forwarding local port 4101.
OPENGENI_DEMO_MCP_URL=

# Production-only. PORT enables one same-origin server for UI, API, and MCP.
# PORT=8080
# OPENGENI_DEMO_APP_ORIGIN=https://demo.opengeni.ai
# Behind a reverse proxy, the header it sets to the client address (the last
# entry is used). Unset, the per-client limits key on the socket address.
# OPENGENI_DEMO_CLIENT_IP_HEADER=x-forwarded-for
