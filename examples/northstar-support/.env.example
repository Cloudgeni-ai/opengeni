# Server-side only. Never expose these values through a VITE_* variable.
OPENGENI_API_BASE_URL=https://app.opengeni.ai
OPENGENI_WORKSPACE_ID=replace_with_your_workspace_id
# An organization API key on an Admin service account, Access: Custom with
# exactly workspace:read, sessions:create, sessions:read, sessions:control,
# mcp_servers:attach, and members:manage, available only in the workspace
# above (see README). Workspace keys cannot act as the demo operator.
OPENGENI_API_KEY=ogk_replace_me

# Runs use the workspace's default model; the browser cannot choose one. Set a
# workspace budget: it caps what anonymous visitors can spend. Runs also carry
# a $1.00 usage limit when the Opengeni server has per-task usage limits on
# (OPENGENI_SESSION_USAGE_LIMITS_ENABLED); otherwise they start without one.

# Shared only by Opengeni's encrypted per-session MCP credentials and this
# example backend. Generate a long random value.
OPENGENI_DEMO_MCP_TOKEN=replace_with_a_long_random_value

# Optional. Set to the public HTTPS origin or full /mcp URL. When omitted, the
# server auto-detects an ngrok tunnel forwarding local port 4101.
OPENGENI_DEMO_MCP_URL=

# Production-only. PORT enables one same-origin server for UI, API, and MCP.
# PORT=8080
# OPENGENI_DEMO_APP_ORIGIN=https://demo.opengeni.ai
# Behind a reverse proxy, a header it overwrites with the client address, which
# keys the per-network limits (never one the client can set). Unset, or missing
# on a request, they key on the socket address. ingress-nginx (the hosted demo):
# OPENGENI_DEMO_CLIENT_IP_HEADER=x-real-ip
