{
  "name": "@opengeni/example-vue-conversation",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3104",
    "server": "bun --env-file=.env.local src/server.ts",
    "onboard": "bun --env-file=.env.local src/onboard.ts",
    "start": "bun --env-file=.env.local src/server.ts",
    "build": "vue-tsc --noEmit && vite build",
    "test": "bun test src",
    "preview:check": "bun src/visual-check.ts"
  },
  "dependencies": {
    "@opengeni/sdk": "7.5.0",
    "vue": "3.5.43"
  },
  "devDependencies": {
    "@types/bun": "1.3.10",
    "@vitejs/plugin-vue": "6.0.9",
    "playwright": "1.58.2",
    "typescript": "5.9.3",
    "vite": "8.3.2",
    "vue-tsc": "3.2.6"
  }
}
