# Server-side only. Never expose these values through a VITE_* variable.
# A full-access organization API key: it creates the tenant workspace on first use,
# and Opengeni adds each product user to it on their first request.
OPENGENI_API_KEY=ogk_replace_me
# Defaults to https://app.opengeni.ai
OPENGENI_API_BASE_URL=https://app.opengeni.ai
# The customer whose workspace the demo uses (created on first use).
DEMO_TENANT=demo-tenant
