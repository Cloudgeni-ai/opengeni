# Server-side only. Never expose these values through a VITE_* variable.
# A full-access organization API key: it creates the tenant workspace and onboards users.
OPENGENI_API_KEY=ogk_replace_me
OPENGENI_ORGANIZATION_ID=replace_with_your_organization_id
# Defaults to https://app.opengeni.ai
OPENGENI_API_BASE_URL=https://app.opengeni.ai
# The customer whose workspace the demo uses (created by `bun run onboard`).
DEMO_TENANT=demo-tenant
