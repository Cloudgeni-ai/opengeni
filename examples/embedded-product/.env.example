# Server-only. Never use VITE_ variables for these credentials.
OPENGENI_API_BASE_URL=http://127.0.0.1:8000
OPENGENI_API_KEY=
OPENGENI_WORKSPACE_ID=
# Must already be explicitly onboarded by an authorized service operation.
EMBED_DEMO_EXTERNAL_USER=demo-user
# Exact host-selected destination; not accepted from browser request bodies.
EMBED_DEMO_RETURN_URL=http://127.0.0.1:3102/?connected=%2f#connections
# Explicit opt-in to unauthenticated fixed-user LOOPBACK-ONLY example mode.
EMBED_DEMO_LOCAL_AUTH=false