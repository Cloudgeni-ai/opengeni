{
  "manifest_version": 3,
  "name": "OpenGeni Browser",
  "short_name": "OpenGeni",
  "description": "Let your OpenGeni agents work in the Chrome profile and tabs you choose.",
  "version": "0.1.0",
  "key": "",
  "permissions": ["debugger", "nativeMessaging", "storage", "tabs"],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "OpenGeni Browser",
    "default_popup": "popup.html"
  }
}
