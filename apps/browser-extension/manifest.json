{
  "manifest_version": 3,
  "name": "Opengeni Browser",
  "short_name": "Opengeni",
  "description": "Connect your Chrome tabs to Opengeni agents for browser automation.",
  "version": "0.1.2",
  "homepage_url": "https://opengeni.ai/",
  "key": "",
  "permissions": ["debugger", "nativeMessaging", "storage", "tabs"],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Opengeni Browser",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
