{
  "name": "opengeni-developer",
  "version": "0.1.0",
  "description": "Set up OpenGeni SDK access and embed OpenGeni in your product.",
  "author": { "name": "Cloudgeni" },
  "homepage": "https://docs.opengeni.ai/guides/developer-plugin",
  "repository": "https://github.com/Cloudgeni-ai/opengeni",
  "license": "Apache-2.0",
  "keywords": ["opengeni", "sdk", "setup", "embedding"],
  "skills": ["./.agents/skills/opengeni-setup", "./.agents/skills/opengeni-client"],
  "interface": {
    "displayName": "OpenGeni Developer",
    "shortDescription": "Set up and embed OpenGeni",
    "longDescription": "Skills for SDK setup and product integration. No MCP server or UI is bundled.",
    "developerName": "Cloudgeni",
    "category": "Developer Tools",
    "defaultPrompt": ["Set up OpenGeni SDK access", "Embed OpenGeni in this product"]
  },
  "extensions": {
    "com.openai": {
      "onboardingSkill": "./.agents/skills/opengeni-setup/SKILL.md"
    }
  }
}
