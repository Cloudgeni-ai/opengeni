{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["bun"],
    "typeRoots": ["../node_modules/@types"],
    "paths": {
      "@opengeni/sdk/chat": ["../../../../packages/sdk/src/chat/index.ts"],
      "@opengeni/sdk": ["../../../../packages/sdk/src/index.ts"],
      "@opengeni/contracts": ["../../../../packages/contracts/src/index.ts"],
      "@opengeni/contracts/*": ["../../../../packages/contracts/src/*.ts"],
      "@opengeni/connect": ["../../../../packages/connect/src/index.ts"],
      "zod": ["../node_modules/zod"],
      "zod/*": ["../node_modules/zod/*"],
      "yaml": ["../node_modules/yaml"],
      "@noble/hashes/*": ["../node_modules/@noble/hashes/*"]
    }
  },
  "files": ["../out/snippet-check/snippet.ts"]
}
