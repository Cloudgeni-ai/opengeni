{
  "name": "opengeni-film-reveal",
  "private": true,
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "cues": "bun scripts/export-cues.ts",
    "score": "bun run cues && python3 audio/score.py",
    "render": "remotion render src/index.ts Reveal out/reveal.mp4",
    "build": "bash scripts/build.sh",
    "typecheck": "tsc --noEmit",
    "check:snippet": "bun scripts/check-snippet.ts && tsc -p snippet-check/tsconfig.json"
  },
  "dependencies": {
    "@remotion/cli": "4.0.527",
    "@remotion/google-fonts": "4.0.527",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "remotion": "4.0.527"
  },
  "devDependencies": {
    "@noble/hashes": "1.8.0",
    "@types/bun": "^1.4.2",
    "@types/react": "19.2.14",
    "typescript": "5.9.3",
    "yaml": "2.9.0",
    "zod": "4.2.1"
  }
}
