{
  "name": "opengeni-film-the-last-click",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "OpenGeni 30-second film \"The Last Click\" (territory: from clicking to delegating).",
  "scripts": {
    "studio": "remotion studio src/index.ts",
