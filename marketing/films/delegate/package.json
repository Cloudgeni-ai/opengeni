    "qa": "bash scripts/qa.sh out/the-last-click.mp4",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.527",
    "@remotion/cli": "4.0.527",
    "@remotion/fonts": "4.0.527",
    "@remotion/renderer": "4.0.527",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "remotion": "4.0.527"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "typescript": "5.9.3"
  }
}
