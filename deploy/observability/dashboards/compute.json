{
  "uid": "opengeni-compute",
  "title": "Opengeni · Compute",
  "description": "Opengeni compute for one exact namespace and Helm release: the fleet as the control service's leader sees it, the control service's own API, and each host's metrics, which the service passes on to Prometheus. No sandbox or team identity is a metric label.",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": ["30s", "1m", "5m", "15m", "30m", "1h"],
    "time_options": ["1h", "6h", "24h", "7d"]
  },
  "tags": ["opengeni", "observability", "compute"],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1
      },
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(compute_control_leader, namespace)",
          "refId": "namespace"
        },
        "definition": "label_values(compute_control_leader, namespace)",
        "current": {},
        "includeAll": false,
        "multi": false,
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "release",
        "label": "Release",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(compute_control_leader{namespace=\"$namespace\"}, release)",
          "refId": "release"
        },
        "definition": "label_values(compute_control_leader{namespace=\"$namespace\"}, release)",
        "current": {},
        "includeAll": false,
        "multi": false,
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "host",
        "label": "Host",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(compute_fleet_host_info{namespace=\"$namespace\",release=\"$release\"}, host_name)",
          "refId": "host"
        },
        "definition": "label_values(compute_fleet_host_info{namespace=\"$namespace\",release=\"$release\"}, host_name)",
        "current": {},
        "includeAll": true,
        "multi": true,
        "refresh": 2,
        "sort": 1,
        "allValue": ".*"
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Fleet",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Hosts by state",
      "description": "Hosts the control service knows, by state, as its leader last read them.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count by (state) (max by (host_name, state) (compute_fleet_host_info{namespace=\"$namespace\",release=\"$release\"}))",
          "legendFormat": "{{state}}",
          "editorMode": "code",
          "range": false,
          "instant": true
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 4
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Sandboxes",
      "description": "Sandboxes the hosts hold, awake or asleep on them, and those whose VM runs.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(max by (host_name) (compute_fleet_host_sandboxes{namespace=\"$namespace\",release=\"$release\"}))",
          "legendFormat": "held",
          "editorMode": "code",
          "range": false,
          "instant": true
        },
        {
          "refId": "B",
          "expr": "sum(max by (host_name) (compute_fleet_host_sandboxes_awake{namespace=\"$namespace\",release=\"$release\"}))",
          "legendFormat": "awake",
          "editorMode": "code",
          "range": false,
          "instant": true
        }
      ],
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 6,
        "h": 4
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Memory free to promise",
      "description": "Memory the hosts can still promise to sandboxes that wake, beyond their buffers.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(max by (host_name) (compute_fleet_host_memory_free_bytes{namespace=\"$namespace\",release=\"$release\"}))",
          "legendFormat": "free",
          "editorMode": "code",
          "range": false,
          "instant": true
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 6,
        "h": 4
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "CPU free to reserve",
      "description": "Processor time wakes can still reserve on the hosts, in cores.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(max by (host_name) (compute_fleet_host_cpu_free_cores{namespace=\"$namespace\",release=\"$release\"}))",
          "legendFormat": "cores",
          "editorMode": "code",
          "range": false,
          "instant": true
        }
      ],
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 6,
        "h": 4
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Memory per host",
      "description": "Memory each host gives sandboxes in all, and what it can still promise.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["last", "max"]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (host_name) (compute_fleet_host_memory_bytes{namespace=\"$namespace\",release=\"$release\",host_name=~\"$host\"})",
          "legendFormat": "{{host_name}} total",
          "editorMode": "code",
          "range": true
        },
        {
          "refId": "B",
          "expr": "max by (host_name) (compute_fleet_host_memory_free_bytes{namespace=\"$namespace\",release=\"$release\",host_name=~\"$host\"})",
          "legendFormat": "{{host_name}} free",
          "editorMode": "code",
          "range": true
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "CPU per host",
      "description": "Processor time each host guarantees sandboxes, and what a wake can still reserve, in cores.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["last", "max"]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (host_name) (compute_fleet_host_cpu_guaranteed_cores{namespace=\"$namespace\",release=\"$release\",host_name=~\"$host\"})",
          "legendFormat": "{{host_name}} guaranteed",
          "editorMode": "code",
          "range": true
        },
        {
          "refId": "B",
          "expr": "max by (host_name) (compute_fleet_host_cpu_free_cores{namespace=\"$namespace\",release=\"$release\",host_name=~\"$host\"})",
          "legendFormat": "{{host_name}} free",
          "editorMode": "code",
          "range": true
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Sandboxes per host",
      "description": "Sandboxes each host holds, and those awake on it.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["last", "max"]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (host_name) (compute_fleet_host_sandboxes{namespace=\"$namespace\",release=\"$release\",host_name=~\"$host\"})",
          "legendFormat": "{{host_name}} held",
          "editorMode": "code",
          "range": true
        },
        {
          "refId": "B",
          "expr": "max by (host_name) (compute_fleet_host_sandboxes_awake{namespace=\"$namespace\",release=\"$release\",host_name=~\"$host\"})",
          "legendFormat": "{{host_name}} awake",
          "editorMode": "code",
          "range": true
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Disk free per host",
      "description": "Disk free for sandboxes on each host, as a share of what it gives them.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["last", "max"]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (host_name) (compute_fleet_host_disk_free_bytes{namespace=\"$namespace\",release=\"$release\",host_name=~\"$host\"}) / max by (host_name) (compute_fleet_host_disk_bytes{namespace=\"$namespace\",release=\"$release\",host_name=~\"$host\"} > 0)",
          "legendFormat": "{{host_name}}",
          "editorMode": "code",
          "range": true
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Host group",
      "description": "The host group as the leader last sized it: its size, its maximum, and its members by state.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["last", "max"]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(compute_fleet_group_size{namespace=\"$namespace\",release=\"$release\"})",
          "legendFormat": "size",
          "editorMode": "code",
          "range": true
        },
        {
          "refId": "B",
          "expr": "max(compute_fleet_group_max_size{namespace=\"$namespace\",release=\"$release\"})",
          "legendFormat": "maximum",
          "editorMode": "code",
          "range": true
        },
        {
          "refId": "C",
          "expr": "max by (state) (compute_fleet_group_hosts{namespace=\"$namespace\",release=\"$release\"})",
          "legendFormat": "{{state}}",
          "editorMode": "code",
          "range": true
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Lease renewal age",
      "description": "How long ago each host's lease was last renewed, as the leader watched it. Hosts renew every few seconds and are given up on after 15 s.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["last", "max"]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (host_name) (compute_fleet_host_renewal_age_seconds{namespace=\"$namespace\",release=\"$release\",host_name=~\"$host\"})",
          "legendFormat": "{{host_name}}",
          "editorMode": "code",
          "range": true
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 12,
      "type": "row",
      "title": "Control service",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "API requests",
      "description": "Public API requests the replicas answered, by route and outcome.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["last", "max"]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (method, route, outcome) (rate(compute_control_requests_total{namespace=\"$namespace\",release=\"$release\"}[$__rate_interval]))",
          "legendFormat": "{{method}} {{route}} {{outcome}}",
          "editorMode": "code",
          "range": true
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "API latency p95",
      "description": "How long the replicas took to answer, by route; a connect until its stream starts.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["last", "max"]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, method, route) (rate(compute_control_request_duration_seconds_bucket{namespace=\"$namespace\",release=\"$release\"}[$__rate_interval])))",
          "legendFormat": "{{method}} {{route}}",
          "editorMode": "code",
          "range": true
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 30,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Replicas and leader",
      "description": "Each replica's scrape health, and which one leads.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["last", "max"]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (pod) (up{namespace=\"$namespace\",release=\"$release\",opengeni_workload_component=\"compute-control\"})",
          "legendFormat": "{{pod}} up",
          "editorMode": "code",
          "range": true
        },
        {
          "refId": "B",
          "expr": "max by (pod) (compute_control_leader{namespace=\"$namespace\",release=\"$release\"})",
          "legendFormat": "{{pod}} leads",
          "editorMode": "code",
          "range": true
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 38,
        "w": 8,
        "h": 8
      }
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Hosts given up and failures",
      "description": "Hosts given up on, give-ups that failed in their fence or the store, and failed sizings of the host group.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["last", "max"]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(compute_control_hosts_given_up_total{namespace=\"$namespace\",release=\"$release\"}[$__rate_interval]))",
          "legendFormat": "given up",
          "editorMode": "code",
          "range": true
        },
        {
          "refId": "B",
          "expr": "sum(increase(compute_control_give_up_failures_total{namespace=\"$namespace\",release=\"$release\"}[$__rate_interval]))",
          "legendFormat": "give-up failures",
          "editorMode": "code",
          "range": true
        },
        {
          "refId": "C",
          "expr": "sum(increase(compute_control_group_failures_total{namespace=\"$namespace\",release=\"$release\"}[$__rate_interval]))",
          "legendFormat": "group failures",
          "editorMode": "code",
          "range": true
        }
      ],
      "gridPos": {
        "x": 8,
        "y": 38,
        "w": 8,
        "h": 8
      }
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Host metrics passed on",
      "description": "Host metric exports the replicas passed on to Prometheus, refused, or failed to pass on.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["last", "max"]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (increase(compute_control_host_metrics_total{namespace=\"$namespace\",release=\"$release\"}[$__rate_interval]))",
          "legendFormat": "{{outcome}}",
          "editorMode": "code",
          "range": true
        }
      ],
      "gridPos": {
        "x": 16,
        "y": 38,
        "w": 8,
        "h": 8
      }
    },
    {
      "id": 18,
      "type": "row",
      "title": "Hosts",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 46,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 19,
      "type": "stat",
      "title": "Alarms",
      "description": "Things that must never happen, over the time range: copies lost, failing verification or quarantined, sandboxes broken or their programs lost. The host's journal has a compute.alarm event naming each.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (compute_alarm) (increase(compute_alarm_count_total{host_name=~\"$host\"}[$__range])) > 0",
          "legendFormat": "{{compute_alarm}}",
          "editorMode": "code",
          "range": false,
          "instant": true
        }
