# Copy to .env and fill in. Never commit .env.

OPENGENI_SERVICE_NAME=opengeni
OPENGENI_ENVIRONMENT=local
OPENGENI_DATABASE_URL=postgres://opengeni_app:opengeni_app@127.0.0.1:5432/opengeni
OPENGENI_MIGRATIONS_DATABASE_URL=postgres://opengeni:opengeni@127.0.0.1:5432/opengeni
# Exact comma-separated API/worker database logins drained by maintenance cutovers.
OPENGENI_MIGRATION_APPLICATION_DATABASE_ROLES=opengeni_app
OPENGENI_APP_DATABASE_USER=opengeni_app
OPENGENI_APP_DATABASE_PASSWORD=opengeni_app
# Standalone FORCE-RLS processes must connect as this exact restricted login.
# Local `bun run dev` rewrites OPENGENI_DATABASE_URL to the provisioned role.
OPENGENI_RUNTIME_DATABASE_ROLE=opengeni_app
OPENGENI_NATS_URL=nats://127.0.0.1:4222
OPENGENI_TEMPORAL_HOST=127.0.0.1:7233
OPENGENI_TEMPORAL_NAMESPACE=default
OPENGENI_TEMPORAL_TASK_QUEUE=opengeni-runs-ts
# Temporal Cloud: set OPENGENI_TEMPORAL_API_KEY; TLS is enabled automatically.
# For TLS without an API key, set OPENGENI_TEMPORAL_TLS_ENABLED=true. The
# remaining fields are optional custom-CA / SNI / mTLS configuration.
OPENGENI_TEMPORAL_TLS_ENABLED=false
# OPENGENI_TEMPORAL_API_KEY=
# OPENGENI_TEMPORAL_TLS_SERVER_NAME=
# OPENGENI_TEMPORAL_TLS_ROOT_CA_CERTIFICATE_BASE64=
# OPENGENI_TEMPORAL_TLS_CLIENT_CERTIFICATE_BASE64=
# OPENGENI_TEMPORAL_TLS_CLIENT_PRIVATE_KEY_BASE64=
OPENGENI_STARTUP_DEPENDENCY_RETRY_ATTEMPTS=30
OPENGENI_STARTUP_DEPENDENCY_RETRY_INITIAL_DELAY_MS=1000
OPENGENI_STARTUP_DEPENDENCY_RETRY_MAX_DELAY_MS=5000
# Fixed keeps a static per-process ceiling. Resource-aware Helm profiles use
# cgroup-aware admission plus a hard maximum and horizontal scaling.
OPENGENI_TURN_WORKER_CONCURRENCY_MODE=fixed
OPENGENI_TURN_WORKER_MAX_CONCURRENT_TURNS=16
OPENGENI_TURN_WORKER_TARGET_CPU_USAGE=0.8
OPENGENI_TURN_WORKER_TARGET_MEMORY_USAGE=0.75
# Admission pressure is normal; only this distinct emergency threshold may
# invoke the graceful drain/checkpoint fallback.
OPENGENI_TURN_WORKER_EMERGENCY_MEMORY_USAGE=0.9
OPENGENI_TURN_WORKER_MEMORY_GUARD_INTERVAL_MS=5000
OPENGENI_TURN_WORKER_MEMORY_GUARD_SUSTAIN_MS=30000
OPENGENI_OBSERVABILITY_STRUCTURED_LOGS=false
OPENGENI_OBSERVABILITY_METRICS_ENABLED=true
# OPENGENI_OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# OPENGENI_OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer token
# Optional, consent-aware browser analytics. Disabled by default for every
# self-hosted deployment. Provider identifiers are public browser configuration;
# never put administrative or server-side provider secrets here.
OPENGENI_ANALYTICS_ENABLED=false
OPENGENI_ANALYTICS_CONSENT_REQUIRED=true
# OPENGENI_ANALYTICS_REO_CLIENT_ID=
# OPENGENI_ANALYTICS_POSTHOG_PROJECT_KEY=
# OPENGENI_ANALYTICS_POSTHOG_HOST=https://eu.i.posthog.com
# OPENGENI_ANALYTICS_GA4_MEASUREMENT_ID=G-ABC123
# Optional deployment shared-key boundary. This is an infra/edge gate, not the
# product API key system. When enabled, protected API, MCP, file, document,
# session, scheduled-task, billing, and SSE routes require:
#   x-opengeni-access-key: <OPENGENI_ACCESS_KEY>
# Product API keys and delegated access tokens use Authorization: Bearer instead.
OPENGENI_AUTH_REQUIRED=false
# OPENGENI_ACCESS_KEY=replace-with-a-long-random-deployment-key
OPENGENI_AUTH_ALLOW_HEALTH=true
OPENGENI_AUTH_ALLOW_METRICS=false
OPENGENI_API_HOST=0.0.0.0
OPENGENI_API_PORT=8000
OPENGENI_WORKER_HTTP_PORT=8001
# Dedicated immutable Apps origin process. The resolver key is a distinct
# internal shared secret; never reuse the deployment access key.
# OPENGENI_APP_HOST_HOST=0.0.0.0
# OPENGENI_APP_HOST_PORT=8080
# OPENGENI_APP_HOST_RESOLVER_URL=http://127.0.0.1:8000/internal/apps/resolve-launch
# OPENGENI_APP_HOST_RESOLVER_KEY=replace-with-a-long-random-resolver-key
# OPENGENI_APP_HOST_RESOLVER_TIMEOUT_MS=2000
# OPENGENI_APP_HOST_FRAME_ANCESTORS=https://console.example.com
# OPENGENI_APPS_ENABLED=false
# OPENGENI_APP_ORIGIN_TEMPLATE=https://{appId}.apps.example.com
# Health/metrics port for the second (turn-role) worker `bun run dev` starts.
# Only the dev stack reads this; each deployed worker pod sets
# OPENGENI_WORKER_HTTP_PORT in its own network namespace.
OPENGENI_TURN_WORKER_HTTP_PORT=8002
# CORS origin allowlist regex. The API matches this as a full-string regex.
OPENGENI_CORS_ALLOW_ORIGIN_REGEX='^https?://(localhost|127\.0\.0\.1)(:\d+)?$'

# Local infrastructure backend. `auto` uses Docker when its daemon is reachable
# and otherwise runs PostgreSQL, NATS, Temporal, and MinIO as native processes.
# Native infrastructure automatically uses the in-process local sandbox provider
# when this copied file still has OPENGENI_SANDBOX_BACKEND=docker.
OPENGENI_DEV_BACKEND=auto
# OPENGENI_DOCKER_PROBE_TIMEOUT_SECONDS=3

# Optional local infrastructure host port overrides. `bun run dev` auto-selects
# free ports when these defaults are occupied and writes them to .env.runtime.
OPENGENI_POSTGRES_HOST_PORT=5432
OPENGENI_NATS_HOST_PORT=4222
OPENGENI_NATS_MONITOR_HOST_PORT=8222
OPENGENI_TEMPORAL_HOST_PORT=7233
# Native Temporal development UI (not started by Docker Compose):
OPENGENI_TEMPORAL_UI_HOST_PORT=8233
OPENGENI_GARAGE_HOST_PORT=3900
# Opt-in MinIO fixture (`OPENGENI_OBJECT_STORAGE_FIXTURE=minio`):
OPENGENI_MINIO_HOST_PORT=9000
OPENGENI_MINIO_CONSOLE_HOST_PORT=9001
OPENGENI_WEB_PORT=3000
# Comma-separated hosts accepted by Vite dev/preview. Required when the web
# container is exposed through a real staging/prod hostname.
# OPENGENI_WEB_ALLOWED_HOSTS=app.opengeni.ai,staging.app.opengeni.ai

# Product posture. Modes are intentionally separate from infrastructure profile.
# local: dev default workspace/subject. configured: self-host/embedded tokens or
# deployment key. managed: Better Auth email/password for humans plus OpenGeni API keys.
OPENGENI_PRODUCT_ACCESS_MODE=local
# Canonical organization-tenancy authority activation. Default false = the
# reversible pre-activation posture; leaving it unset or false is how an operator
# declines or defers the one-way tenancy cutover. Set true only after proving the
# activation preconditions in docs/organization-tenancy.md. It is not a kill
# switch: after an activation migration commits, setting it back to false does
# not restore the legacy authority.
OPENGENI_ORGANIZATION_TENANCY_CANONICAL_ACTIVATION_ENABLED=false
OPENGENI_BILLING_MODE=disabled
OPENGENI_ENTITLEMENTS_MODE=none
OPENGENI_USAGE_LIMITS_MODE=none
# OPENGENI_PUBLIC_BASE_URL=https://app.opengeni.ai
# Optional separate browser origin for local split API/web development.
# OPENGENI_WEB_BASE_URL=http://127.0.0.1:3000
# Public agent archive and explicit stable-channel promotion pointer. The stable
# version must already exist as an `agent-v<version>` release.
# OPENGENI_AGENT_RELEASES_BASE_URL=https://github.com/Cloudgeni-ai/opengeni/releases
# OPENGENI_AGENT_STABLE_VERSION=0.1.16
# OPENGENI_AGENT_BETA_VERSION=
# OPENGENI_DELEGATION_SECRET=replace-with-long-random-token-signing-secret
# Optional JSON arrays or comma-separated names. `default` controls omitted
# session selections; `allowed` is a hard execution ceiling. Unset preserves
# the built-in OpenGeni defaults and complete catalog.
# OPENGENI_DEFAULT_FIRST_PARTY_MCP_TOOLS=session_get,session_events,goal_update,goal_complete,goal_pause
# OPENGENI_ALLOWED_FIRST_PARTY_MCP_TOOLS=session_get,session_events,goal_update,goal_complete,goal_pause
# Permission-first advisory work discovery. Disable this to reject query/exact-
# subject discovery while keeping ordinary session browsing available without
# claim projections. Existing durable evidence is not deleted.
OPENGENI_WORK_DISCOVERY_ENABLED=true
# Independently remove exact-attempt work-claim mutation tools. Lifecycle
# settlement and authorized reads of existing evidence remain active.
OPENGENI_WORK_CLAIM_MUTATIONS_ENABLED=true
# Human presentation rollout; the topology response carries this decision so a
# client can hide advisory UI without changing API authority or evidence.
OPENGENI_WORK_DISCOVERY_HUMAN_ADVISORIES_ENABLED=true
# Reserved rollout marker. No automatic overlap-nudge producer is shipped;
# keep false unless a later reviewed implementation explicitly consumes it.
OPENGENI_WORK_DISCOVERY_AUTOMATIC_NUDGES_ENABLED=false
# OPENGENI_STATIC_ENTITLEMENTS_JSON='{"feature_key":true}'
# OPENGENI_STATIC_USAGE_LIMITS_JSON='{"maxWorkspacesPerAccount":1,"maxMonthlyAgentRunsPerWorkspace":100}'

# Workspace environments (per-workspace secret env vars injected into attached runs).
# Required in managed mode outside local/test; without it the environment routes return 503.
# Generate with: openssl rand -base64 32
# `bun run dev` generates and persists this automatically when absent.
# OPENGENI_ENVIRONMENTS_ENCRYPTION_KEY=replace-with-base64-32-byte-key

# Integrations / MCP OAuth client. Enable only with a stable public base URL and
# state key outside local/test. Operator OAuth clients are keyed by AS issuer
# or AS URL: {"https://as.example.com":{"clientId":"...","clientSecret":"..."}}}}
OPENGENI_INTEGRATIONS_ENABLED=false
# {secret_name}=
# OPENGENI_INTEGRATIONS_OAUTH_CLIENTS_JSON='{{}}'
# Gmail's official hosted MCP uses a Google OAuth "Web application" client.
# First register the authorizing Workspace account and Cloud project in the
# Google Workspace Developer Preview Program. Then enable the Gmail API and
# Gmail MCP API, approve read-only, compose, and modify access, and register
# this callback:
#   ${{OPENGENI_PUBLIC_BASE_URL}}/v1/integrations/oauth/callback
# then configure the deployment-owned client under Google's issuer:
# OPENGENI_INTEGRATIONS_OAUTH_CLIENTS_JSON='{"https://accounts.google.com":{"clientId":"...","clientSecret":"...","tokenEndpointAuthMethod":"client_secret_post"}}'
# Operator OAuth apps for first-party social connectors (X / Reddit), keyed by
# provider id. Register the callback URL <public-base-url>/v1/social/oauth/callback
# in each provider's app settings.
# OPENGENI_SOCIAL_OAUTH_CLIENTS_JSON='{"x":{"clientId":"...","clientSecret":"..."},"reddit":{"clientId":"...","clientSecret":"..."}}'
# OPENGENI_INTEGRATIONS_ALLOW_PRIVATE_NETWORK_TARGETS=false

# One configured Slack app can serve personal hosted MCP OAuth and the separate
# OpenGeni workspace-bot principal (the only shared Slack identity). Configure:
#   ${{OPENGENI_PUBLIC_BASE_URL}}/v1/integrations/oauth/callback  # hosted MCP
#   ${{OPENGENI_PUBLIC_BASE_URL}}/v1/integrations/slack/callback
# Use a distinct Slack app and credential triplet for every deployed environment.
# The app and bot display names must match the same deployment identity. The
# API validates the bot name again before accepting an installation.
# OPENGENI_SLACK_APP_NAME=OpenGeni Staging
# OPENGENI_SLACK_BOT_DISPLAY_NAME=OpenGeni Staging
# OPENGENI_SLACK_COMMAND=/opengeni-staging
# OPENGENI_SLACK_SHORTCUT_NAME=Open in OpenGeni Staging
# OPENGENI_SLACK_CLIENT_ID=
# {slack_secret}=
# OPENGENI_SLACK_SIGNING_SECRET=

# Google Drive read-only folder/Shared Drive source sync. Configure this callback on a
# Google OAuth "Web application" client:
#   ${{OPENGENI_PUBLIC_BASE_URL}}/v1/integrations/google-drive/callback
# OPENGENI_GOOGLE_DRIVE_CLIENT_ID=
# {google_drive_client_secret}=
# Per-source resource budgets are frozen into newly created or updated Drive
# sync Schedules. Existing Schedules retain their already persisted limits.
# OPENGENI_GOOGLE_DRIVE_SYNC_MAX_ITEMS=500
# OPENGENI_GOOGLE_DRIVE_SYNC_MAX_BYTES=500000000
# OPENGENI_GOOGLE_DRIVE_SYNC_MAX_FILE_BYTES=100000000
# OPENGENI_GOOGLE_DRIVE_SYNC_MAX_PROVIDER_REQUESTS=1000
# OPENGENI_GOOGLE_DRIVE_SYNC_MAX_ELAPSED_SECONDS=300
# OPENGENI_GOOGLE_DRIVE_SYNC_MAX_FAILURE_DETAILS=25
# Individual transport failures, HTTP 429, and HTTP 5xx responses may retry
# only inside this bounded request budget. Durable workflow recovery remains
# authoritative after exhaustion.
# OPENGENI_GOOGLE_DRIVE_PROVIDER_REQUEST_TIMEOUT_MS=30000
# OPENGENI_GOOGLE_DRIVE_PROVIDER_RETRY_ATTEMPTS=3
# OPENGENI_GOOGLE_DRIVE_PROVIDER_RETRY_INITIAL_DELAY_MS=250
# OPENGENI_GOOGLE_DRIVE_PROVIDER_RETRY_MAX_DELAY_MS=5000
# OPENGENI_GOOGLE_DRIVE_PROVIDER_RETRY_BUDGET_MS=15000

# Reviewed GitHub repository API tools for both the workspace App and personal OAuth.
# Authority remains resource-backed; enabling this alone does not add any repository.
OPENGENI_GITHUB_REST_MCP_ENABLED=false

# Personal GitHub user OAuth. This is deliberately a separate OAuth App from
# the workspace-owned OpenGeni GitHub App below. Register one OAuth App per
# managed environment, or one for a local/self-hosted installation, with exactly
# this callback (localhost HTTP is supported in local/test):
#   ${{OPENGENI_PUBLIC_BASE_URL}}/v1/integrations/github-personal/oauth/callback
# Keep disabled until that environment's OAuth App and encrypted secret are set.
OPENGENI_GITHUB_PERSONAL_OAUTH_ENABLED=false
# OPENGENI_GITHUB_PERSONAL_OAUTH_CLIENT_ID=
# OPENGENI_GITHUB_PERSONAL_OAUTH_CLIENT_SECRET=

# Fiken accounting OAuth (docs/fiken.md). Register a Fiken App (Rediger konto
# -> API) with this redirect URL:
#   ${{OPENGENI_PUBLIC_BASE_URL}}/v1/integrations/fiken/callback
# Without these, the Fiken connector still works via pasted personal API tokens.
# OPENGENI_FIKEN_OAUTH_CLIENT_ID=
# OPENGENI_FIKEN_OAUTH_CLIENT_SECRET=
# Developer Preview wake hints only. Drive Changes plus bounded full
# reconciliation remain authoritative when this optional path is enabled.
# OPENGENI_GOOGLE_DRIVE_WORKSPACE_EVENTS_ENABLED=false

# Jira and Confluence read-only source sync through one Atlassian OAuth 2.0 app:
#   ${{OPENGENI_PUBLIC_BASE_URL}}/v1/integrations/atlassian/callback
# OPENGENI_ATLASSIAN_CLIENT_ID=
# OPENGENI_ATLASSIAN_CLIENT_SECRET=
# Session goal guard rails (see docs/goals.md). Goals are uncapped by count
# by default (agents legitimately run for days); set a max only if a
# deployment needs a hard ceiling. OpenGeni does not infer progress from event shape.
# OPENGENI_GOAL_MAX_AUTO_CONTINUATIONS=
# Pacing between CONSECUTIVE no-input goal continuations (not a cap): comma
# list of delays in ms (default 3000,30000,120000,300000; last entry repeats)
# and a hard ceiling on any delay (default 600000). Any new input (child
# result, agent message, human prompt, Steer) wakes the session immediately.
# OPENGENI_GOAL_IDLE_BACKOFF_MS=
# OPENGENI_GOAL_IDLE_BACKOFF_MAX_MS=
# Conversation-history source (issue #35; see docs/run-lifecycle.md). Items +
# the sandbox envelope are dual-written unconditionally; this flips the READ
# path only. Default is "items" (SDK-native history items from the DB); set
# "run_state" to fall back to the legacy serialized RunState blob.

# Managed mode human auth and transactional email.
# OPENGENI_BETTER_AUTH_SECRET=replace-with-long-random-better-auth-secret
# OPENGENI_BETTER_AUTH_TRUSTED_ORIGINS=https://app.opengeni.ai,https://staging.app.opengeni.ai
# OPENGENI_BETTER_AUTH_ALLOWED_HOSTS=app.opengeni.ai,staging.app.opengeni.ai
# OPENGENI_BETTER_AUTH_COOKIE_DOMAIN=.opengeni.ai
# Optional managed sign-in providers. Each complete pair enables its button.
# Callbacks are <PUBLIC_BASE_URL>/v1/auth/callback/google and
# <PUBLIC_BASE_URL>/v1/auth/callback/github.
# OPENGENI_MANAGED_AUTH_GOOGLE_CLIENT_ID=
# OPENGENI_MANAGED_AUTH_GOOGLE_CLIENT_SECRET=
# OPENGENI_MANAGED_AUTH_GITHUB_CLIENT_ID=
# OPENGENI_MANAGED_AUTH_GITHUB_CLIENT_SECRET=
# Browser login slots: legacy (default), dual (rolling coexistence), or broker.
# Apply migration 0362 first. dual/broker are explicit deployment cutovers; see
# docs/browser-login-session-sets.md. Do not mix modes across API replicas.
# OPENGENI_MANAGED_AUTH_SESSION_SET_MODE=legacy
# OPENGENI_RESEND_API_KEY=re_...

# Stripe test/live billing. First release uses prepaid credit Checkout payments.
# Route/domain code checks local credit ledger, usage, and entitlements, not Stripe synchronously.
# OPENGENI_STRIPE_SECRET_KEY=sk_test_...
# OPENGENI_STRIPE_PUBLISHABLE_KEY=pk_test_...
# OPENGENI_STRIPE_WEBHOOK_SECRET=whsec_...
# Optional dedicated Stripe Product for flexible prepaid credit Checkout line items.
# OPENGENI_STRIPE_CREDITS_PRODUCT_ID=prod_...
# Production live-mode read-only preflight uses explicit live keys and live object ids.
# Do not set these to test-mode values.
# STRIPE_LIVE_SECRET_KEY=sk_live_...
# STRIPE_LIVE_PUBLISHABLE_KEY=pk_live_...
# STRIPE_LIVE_WEBHOOK_SECRET=whsec_...
# OPENGENI_STRIPE_LIVE_CREDITS_PRODUCT_ID=prod_...
# OPENGENI_STRIPE_LIVE_WEBHOOK_URL=https://app.opengeni.ai/v1/webhooks/stripe
# Optional override for model cost accounting. Values are micros of USD per
# million tokens, before marginBps.
# OPENGENI_MODEL_PRICING_JSON='{"gpt-5.6-sol":{"inputMicrosPerMillionTokens":5000000,"cachedInputMicrosPerMillionTokens":500000,"outputMicrosPerMillionTokens":30000000,"marginBps":2500}}'

# OpenAI provider.
OPENGENI_OPENAI_PROVIDER=openai
OPENGENI_OPENAI_MODEL=gpt-5.6-sol
OPENGENI_OPENAI_REASONING_EFFORT=low
OPENGENI_OPENAI_ALLOWED_MODELS=gpt-5.6-sol,gpt-5.6-terra,gpt-5.6-luna
OPENGENI_OPENAI_ALLOWED_REASONING_EFFORTS=low,medium,high,xhigh,max
OPENGENI_OPENAI_API_KEY=your-key
# Optional OpenGeni-managed AI Gateway key. Adds the curated DeepSeek and Kimi
# models; workspace-owned Gateway keys are connected encrypted in Settings.
# OPENGENI_VERCEL_AI_GATEWAY_API_KEY=vck_...
# Image model used only by the workspace-owned Gateway image adapter. Direct
# OpenAI and connected Codex use their native/account-scoped GPT Image 2 paths.
# OPENGENI_IMAGE_GENERATION_MODEL=openai/gpt-image-2
# Durable Seedance video generation uses the workspace-owned Gateway connection.
# These are server-owned safety/operational ceilings, not workspace UI knobs.
# OPENGENI_VIDEO_GENERATION_POLL_INTERVAL_MS=5000
# OPENGENI_VIDEO_GENERATION_RECOVERY_DEADLINE_MS=7200000
# OPENGENI_VIDEO_GENERATION_REFERENCE_URL_TTL_SECONDS=3600
# OPENGENI_VIDEO_GENERATION_MAX_CONCURRENT_PER_WORKSPACE=2
# OPENGENI_VIDEO_GENERATION_WORKSPACE_QUOTA_BYTES=21474836480
# OPENGENI_VIDEO_GENERATION_TEMP_DIRECTORY=/tmp/opengeni-video
# OPENGENI_VIDEO_GENERATION_FFPROBE_PATH=ffprobe
# OpenGeni-credit customer price (USD micros per generated second).
# OPENGENI_VIDEO_GENERATION_CREDIT_480P_MICROS_PER_SECOND=155000
# OPENGENI_VIDEO_GENERATION_CREDIT_720P_MICROS_PER_SECOND=350000
# OPENGENI_OPENAI_BASE_URL=https://api.openai.com/v1
# OPENGENI_OPENAI_RESPONSES_TRANSPORT=websocket
# Provider item ids in model-call input: "strip" (default) keeps requests
# self-contained instead of resolving rs_/msg_/fc_ ids against the provider's
# response store (which can lose items mid-run); "preserve" passes them through.
# OPENGENI_OPENAI_PROVIDER_ITEM_IDS=strip
# Round-trip reasoning.encrypted_content with each call so reasoning survives
# without provider-side response storage (default true).
# OPENGENI_OPENAI_REASONING_ENCRYPTED_CONTENT=true

# Native composer voice input. The one-shot endpoint remains available for legacy
# clients. Resumable clients persist exact-subject manifests in Postgres, upload
# hash-bound chunks to object storage, and use ffmpeg to prepare bounded WAV
# segments. The first provider selected is pinned for the whole recording.
# Reuses OPENGENI_OPENAI_API_KEY / Azure turn credentials when voice-specific
# overrides are unset. Template placeholders like `your-key` are ignored so the
# mic is not advertised until a real key exists. When Codex subscription routing
# is enabled, Codex STT is preferred by default (even if OpenAI/Azure keys exist);
# workspaces without an attached subscription fall through to OpenAI/Azure.
# Resumable capability is advertised only when object storage, ffmpeg, and a
# provider are all ready. Completion/discard removes audio best-effort immediately;
# abandoned audio and persisted transcript metadata expire after retention plus
# the existing reaper cleanup grace.
# OPENGENI_VOICE_INPUT_MAX_DURATION_SECONDS=60
# OPENGENI_VOICE_INPUT_MAX_SIZE_BYTES=26214400
# OPENGENI_VOICE_INPUT_RESUMABLE_ENABLED=true
# OPENGENI_VOICE_INPUT_RESUMABLE_MAX_DURATION_SECONDS=7200
# OPENGENI_VOICE_INPUT_RESUMABLE_MAX_SIZE_BYTES=536870912
# OPENGENI_VOICE_INPUT_RESUMABLE_MAX_CHUNK_SIZE_BYTES=8388608
# OPENGENI_VOICE_INPUT_RESUMABLE_RETENTION_SECONDS=86400
# OPENGENI_VOICE_INPUT_FFMPEG_PATH=ffmpeg
# OPENGENI_VOICE_INPUT_PROVIDER_ORDER=codex-subscription,openai,azure-openai
# OPENGENI_VOICE_INPUT_OPENAI_ENABLED=true
# OPENGENI_VOICE_INPUT_OPENAI_API_KEY=
# OPENGENI_VOICE_INPUT_OPENAI_BASE_URL=https://api.openai.com/v1
# OPENGENI_VOICE_INPUT_OPENAI_MODEL=gpt-transcribe
# OPENGENI_VOICE_INPUT_AZURE_ENABLED=true
# OPENGENI_VOICE_INPUT_AZURE_ENDPOINT=https://YOUR_RESOURCE.openai.azure.com
# OPENGENI_VOICE_INPUT_AZURE_DEPLOYMENT=your-transcription-deployment
# OPENGENI_VOICE_INPUT_AZURE_API_VERSION=2025-04-01-preview
# OPENGENI_VOICE_INPUT_AZURE_API_KEY=
# OPENGENI_VOICE_INPUT_AZURE_AD_TOKEN=
# Legacy Codex STT opt-in (no longer required; inclusion follows CODEX_SUBSCRIPTION_ENABLED).
# OPENGENI_VOICE_INPUT_CODEX_EXPERIMENTAL=false

# Codex subscription routing and its rolling-deploy safety fence. Leases and
# fairness state are strictly workspace-local. Keep credential leasing false
# until every API/worker replica runs the migration-compatible revision;
# disabling it later restores legacy sticky selection without a schema rollback.
OPENGENI_CODEX_SUBSCRIPTION_ENABLED=true
# Expose ChatGPT/Codex connected apps as MCP tools. Independent from subscription
# model routing and default-off.
# OPENGENI_CODEX_CONNECTED_APPS_ENABLED=false
# OPENGENI_CODEX_CREDENTIAL_LEASING_ENABLED=false
# Emit bounded adaptive-policy replay records without changing placement.
# OPENGENI_CODEX_FLEET_POLICY_SHADOW_ENABLED=false

# SuperGrok/xAI connected-subscription routing. Workspace scope is the default
# shared connection path; private user scope is explicit and available only to
# the exact managed-browser human. Both require the stable environments
# encryption key above because OAuth material is authenticated-encrypted at
# rest. Models use the `supergrok/` namespace and are externally billed.
# The config library stays fail-closed; `bun run dev` enables this when unset,
# matching Codex. Production/Helm must still set the flag explicitly.
OPENGENI_SUPERGROK_SUBSCRIPTION_ENABLED=true
# Abort a SuperGrok response only after this many milliseconds without one
# complete, valid SSE data event. Valid events reset the timer; no total-call cap.
# OPENGENI_SUPERGROK_RESPONSE_STREAM_IDLE_TIMEOUT_MS=300000
# OPENGENI_DISABLE_OPENAI_TRACING=true

# Azure OpenAI provider.
# OPENGENI_OPENAI_PROVIDER=azure
# OPENGENI_AZURE_OPENAI_BASE_URL=https://YOUR_RESOURCE.openai.azure.com/openai/v1
# OPENGENI_AZURE_OPENAI_API_KEY=your-key
# OPENGENI_AZURE_OPENAI_ENDPOINT=https://YOUR_RESOURCE.openai.azure.com
# OPENGENI_AZURE_OPENAI_DEPLOYMENT=your-deployment
# Required only for endpoint/deployment-style Azure URLs. Azure /openai/v1 base URLs omit this query.
# OPENGENI_AZURE_OPENAI_API_VERSION=2025-04-01-preview
# OPENGENI_AZURE_OPENAI_AD_TOKEN=...

# Extra (non-built-in) model providers. The built-in provider above (OpenAI or
# Azure) is always present; this JSON registry exposes ADDITIONAL providers and
# their models. Each entry has its own baseUrl, wire api ("responses" | "chat",
# default "chat"), and the models it serves. The default kind is "api-key" and
# requires an inline apiKey OR an apiKeyEnv naming the env var that holds the key
# (preferred). Explicit kind "anonymous" sends no credential and is externally
# metered. The models a client can pick are the union of
# OPENGENI_OPENAI_ALLOWED_MODELS and every registry model.
# Example: add Fireworks AI serving GLM 5.2 (keep the key in its own env var).
# OPENGENI_FIREWORKS_API_KEY=fw_...
# OPENGENI_MODEL_PROVIDERS_JSON='[{"id":"fireworks","label":"Fireworks AI","api":"chat","baseUrl":"https://api.fireworks.ai/inference/v1","apiKeyEnv":"OPENGENI_FIREWORKS_API_KEY","models":[{"id":"accounts/fireworks/models/glm-5p2","label":"GLM 5.2","contextWindowTokens":1048576,"reasoningEffort":true,"hostedWebSearch":false}]}]'
# Temporary keyless OpenCode Zen example (verify the live /zen/v1/models list
# and current terms before enabling; this preview route is not a production SLA).
# OPENGENI_MODEL_PROVIDERS_JSON='[{"kind":"anonymous","id":"opencode-zen","label":"OpenCode Zen","api":"chat","baseUrl":"https://opencode.ai/zen/v1","models":[{"id":"opencode/x-preview-f-free","upstreamModelId":"x-preview-f-free","label":"OpenCode Ox Alpha (temporary free preview)","contextWindowTokens":1000000,"reasoningEffort":true,"hostedWebSearch":false}]}]'

# Workbench v2 turn-end workspace capture. When on (default), the turn activity
# probes the box's changed files off the live box at turn end and persists a
# capture revision (blobs in object storage) so the workbench paints cold/offline
# sessions instantly with zero machine round-trips. Best-effort and fully behind
# this flag: off ⇒ capture is skipped and reads fall back to the live/wake path.
OPENGENI_WORKSPACE_CAPTURE=true

# Sandbox backend: docker, modal, local, none, daytona, runloop, e2b, blaxel,
# cloudflare, vercel, selfhosted, or opensandbox.
OPENGENI_SANDBOX_BACKEND=docker
# `bun run dev` retains a bounded recent source-tagged sandbox image history,
# preserves every live worktree/container lease, and uses a dedicated BuildKit
# cache capped at 24 GB. One full sandbox build keeps roughly 10-14 GB of cache
# records; a cap below that working set makes every start rebuild the image.
# Override these only for local Docker disk tuning.
OPENGENI_DEV_SANDBOX_IMAGE_RETENTION=3
OPENGENI_DEV_SANDBOX_BUILD_CACHE_MAX=24gb
# Optional shared Cargo target cache for the host-side Rust builds that
# `bun run dev` performs (artifact kernel napi binding, Connected Machine relay).
# Unset (default) keeps each checkout's own in-repo target/ trees. When set to an
# absolute path, parallel git worktrees share compiled dependencies under it.
# OPENGENI_DEV_CARGO_TARGET_DIR=$HOME/.cache/opengeni/cargo-target
# `bun run dev:down` stops only this worktree's Compose stack; `bun run dev:clean`
# additionally removes its data volumes, sandbox image tags, and .env.runtime.
OPENGENI_SANDBOX_WARMING_TIMEOUT_MS=600000
# Budget (ms) a request-scoped session/workspace mutation (Send, Steer,
# Pause/Resume/Cancel, queue move/edit/delete, composer draft, settings
# narrowing, quiescent tree deletion) may wait to enter the workspace control
# prefix before failing with a retryable 503 WORKSPACE_CONTROL_BUSY. Positive
# integer; validated at boot. Worker settlement and claims never use it.
# Default 20000.
# OPENGENI_WORKSPACE_CONTROL_LOCK_TIMEOUT_MS=20000
# Connected Machines are an ordinary local-development capability. Production
# deployments still use their explicit config and the config-library default is
# fail-closed. Set false locally only when testing the disabled product surface.
OPENGENI_SANDBOX_SELFHOSTED_ENABLED=true
# Connected Machine command streaming is on by default. Command duration has no
# inherent limit; set a positive exec timeout only when a deployment explicitly
# wants a hard process deadline. Connected Machine exec requires op-stream and
# never downgrades to request/reply.
OPENGENI_AGENT_OP_STREAM_ENABLED=true
OPENGENI_SANDBOX_SELFHOSTED_EXEC_TIMEOUT_MS=0
OPENGENI_SANDBOX_SELFHOSTED_CONTROL_TIMEOUT_MS=30000
OPENGENI_DOCKER_IMAGE=opengeni-sandbox:local
# Deployment-owned capability contract. Enable only when the exact base image
# is source-tagged for local development or digest-pinned in production and
# contains the verified native artifact runtime. Pack/rig image overrides and
# mutable production refs fail closed; the worker doctors the actual box before
# the model starts.
OPENGENI_SANDBOX_ARTIFACT_RUNTIME_ENABLED=false
# Leave unset for `bun run dev` — scripts/dev-stack.sh sets
# OPENGENI_DOCKER_NETWORK=${COMPOSE_PROJECT_NAME}_default per worktree.
# OPENGENI_DOCKER_NETWORK=opengeni-main_default
# Optional: force a Compose project name (default = slugified directory basename;
# bare basename `opengeni` becomes `opengeni-main` — an explicit override is kept as-is).
# OPENGENI_COMPOSE_PROJECT=
# Optional: honor OPENGENI_*_HOST_PORT / OPENGENI_*_PORT values from this file
# when free (default off so copied .env files cannot collide worktrees).
# OPENGENI_PIN_PORTS=0
# OPENGENI_DOCKER_EXPOSED_PORTS=3000,8080
# Required when a containerized worker controls the host Docker daemon. Bind-mount
# this same absolute path into the worker at the same path.
# OPENGENI_DOCKER_WORKSPACE_BASE_DIR=/var/lib/opengeni/docker-workspaces

# Optional remote BrowserSession placements. The normal OpenGeni browser tools,
# observations, and browserd authority remain identical; only Chromium hosting
# moves to the selected provider. `placementId` is `default` for these static
# credentials. Kernel's session timeout is bounded to one day.
# OPENGENI_BROWSERBASE_API_KEY=
# OPENGENI_KERNEL_API_KEY=
# OPENGENI_KERNEL_ENDPOINT=https://api.onkernel.com
# OPENGENI_KERNEL_BROWSER_TIMEOUT_SECONDS=3600
# OPENGENI_KERNEL_BROWSER_STEALTH=false

# Modal sandbox backend.
OPENGENI_MODAL_APP_NAME=opengeni-sandbox
# Modal's documented per-box maximum. Longer-lived sessions require a
# snapshot/rematerialization transition; this value does not extend a live box.
OPENGENI_MODAL_TIMEOUT_SECONDS=86400
# Start controlled checkpoint + successor rotation before Modal's hard
# creation-time deadline. The default is min(1h, half the configured lifetime);
# short canary lifetimes therefore do not require a coupled override. This is
# not a keepalive and cannot extend the old box.
# OPENGENI_SANDBOX_ROTATION_LEAD_MS=3600000
# OPENGENI_SANDBOX_ROTATION_BATCH_SIZE=1
# The idle-grace default is likewise min(15m, half the configured lifetime).
# OPENGENI_SANDBOX_IDLE_GRACE_MS=900000
# OPENGENI_MODAL_IMAGE_REF=ghcr.io/YOUR_ORG/opengeni-sandbox:dev
# Optional immutable Modal-native image ID for the exact logical image ref
# above. When set, OpenGeni uses ModalImageSelector.fromId and does not import
# the registry reference. Keep the logical ref digest-pinned for lease
# provenance; the Modal session envelope records the actual image ID.
# OPENGENI_MODAL_IMAGE_ID=im-1234567890123456789012
# OPENGENI_MODAL_TOKEN_ID=ak-...
# OPENGENI_MODAL_TOKEN_SECRET=as-...
# OPENGENI_MODAL_ENVIRONMENT=main
# New Modal sandboxes default to directory snapshots so recovery restores only
# the durable workspace instead of cold-booting a full-machine snapshot.
# Existing sandbox envelopes retain the persistence mode they were created with.
# OPENGENI_MODAL_WORKSPACE_PERSISTENCE=snapshot_directory
# Name of a Modal Secret (REGISTRY_USERNAME + REGISTRY_PASSWORD) to authenticate a
# PRIVATE OPENGENI_MODAL_IMAGE_REF or pack sandboxImage (e.g. a cloud ACR/ECR/GCR
# digest). The global OPENGENI_MODAL_IMAGE_REF is warmed at worker boot; pack
# sandboxImage refs are warmed at turn time after pack settings resolve.
# The Secret is resolved with the OPENGENI_MODAL_TOKEN_ID/SECRET client, so
# embedded hosts do not also need standard MODAL_TOKEN_ID/SECRET env or ~/.modal.toml.
# Unset ⇒ the image must be a PUBLIC registry tag (pulled unauthenticated).
# OPENGENI_MODAL_IMAGE_REGISTRY_SECRET=my-registry-credentials

# OpenSandbox Kubernetes backend. Optional and inactive unless
# OPENGENI_SANDBOX_BACKEND=opensandbox. The lifecycle service should normally be
# a private ClusterIP reachable from workers. Keep the API key in the runtime
# Secret, and pin the sandbox image to an immutable OCI digest.
# OPENGENI_OPENSANDBOX_BASE_URL=http://opensandbox-server.opensandbox-system.svc.cluster.local
# OPENGENI_OPENSANDBOX_API_KEY=...
# OPENGENI_OPENSANDBOX_IMAGE=ghcr.io/YOUR_ORG/opengeni-sandbox@sha256:...
# Renewable provider TTL and leak backstop. OpenGeni renews it only while the
# matching durable lease is authoritative and warm.
# OPENGENI_OPENSANDBOX_TTL_SECONDS=3600
# Use the private lifecycle server as the HTTP/WebSocket proxy for execd and
# files. Channel B (browserd 7682, noVNC 6080, ttyd 7681) uses signed URI-mode
# ingress when OPENGENI_OPENSANDBOX_SIGNED_ENDPOINTS=true. Upstream single-tenant
# mode exempts lifecycle proxy routes from API-key checks, so the server must
# remain ClusterIP-only.
# OPENGENI_OPENSANDBOX_USE_SERVER_PROXY=true
# Default false: unsigned Channel B still uses the lifecycle proxy, in-box curl,
# and API frame-proxy. True: signed URI-mode ingress; never those compensations.
# OpenSandbox also requires configured object storage; persist fails closed
# rather than stuffing tar bytes into Postgres.
# OPENGENI_OPENSANDBOX_SIGNED_ENDPOINTS=false
# OPENGENI_OPENSANDBOX_SIGNED_ENDPOINT_TTL_SECONDS=600
# Laptop/port-forward rewrite for Channel B only. Preserves the signed path.
# OPENGENI_OPENSANDBOX_CHANNEL_B_PUBLIC_BASE_URL=http://127.0.0.1:28888
# Emergency hatch only: force JPEG/RFB through the API frame-proxy even when
# signed endpoints are on. Unset ⇒ proxy only while signed endpoints are off.
# OPENGENI_OPENSANDBOX_INTERACTION_FRAME_PROXY=
# Optional homogeneous upstream Pool. Direct BatchSandbox creation remains the
# default and is required for request-specific Pod-template variation.
# OPENGENI_OPENSANDBOX_POOL_REF=
# Optional same-cluster, read-only workload inventory. The Helm chart sets this
# only on the control worker and mounts a dedicated projected service-account
# token with namespace-scoped list permission for Pods and BatchSandboxes.
# OPENGENI_OPENSANDBOX_KUBERNETES_INVENTORY_NAMESPACE=opensandbox

# Sandbox preparation profiles. Profiles allow selected host env vars into the sandbox
# and may enable lifecycle hooks such as Azure CLI login. Default is safest for OSS.
# Supported profiles: none, azure, github.
OPENGENI_SANDBOX_PREPARATION_PROFILES=none
# Add extra host env var names to expose to sandbox manifests.
# OPENGENI_SANDBOX_ENV_ALLOWLIST=TF_VAR_region,CUSTOM_PROVIDER_TOKEN
# Managed sandbox lease ownership is the prerequisite for lazy provisioning.
# Keep both off until the staged ownership/reaper rollout is complete.
# OPENGENI_SANDBOX_OWNERSHIP_ENABLED=false
# OPENGENI_SANDBOX_LAZY_PROVISION=false

# Session-level MCP tool providers. Clients select these by id with `tools: [{ "kind": "mcp", "id": "docs" }]`.
# Worker-side first-party MCP defaults to loopback. Set the internal URL to
# service DNS in split-process deployments; it never needs public ingress.
# OPENGENI_MCP_INTERNAL_URL=http://127.0.0.1:8000/v1/workspaces/{workspaceId}/mcp
# OPENGENI_MCP_URL is only the sandbox/external route used by Codemode and
# remote placements. Leave it unset when publicBaseUrl is the correct route.
# A built-in `docs` provider can also be registered under the same workspace-scoped MCP surface unless overridden here.
# OPENGENI_MCP_URL=http://127.0.0.1:8000/v1/workspaces/{workspaceId}/mcp
# OPENGENI_MCP_SERVERS='[{"id":"docs","name":"Document Search","url":"http://127.0.0.1:8000/v1/workspaces/{workspaceId}/mcp/docs","allowedTools":["search_documents","fetch_document_chunk","list_document_bases"]}]'
# Programmatic sandbox -> tool access through the attempt-frozen Codemode API.
# Managed deployments use OPENGENI_DELEGATION_SECRET. Configured deployments
# with shared-key auth may reuse OPENGENI_ACCESS_KEY; otherwise configure a
# separate delegation secret. Local development receives a local-only secret.
# Token values are written to an attempt-scoped sandbox file, never env.
# Standalone rig verification is fail-closed until every global sandbox reaper
# understands its canonical lease attribution. Roll out recognition first, then
# enable this flag on the shared rig-verification worker queue.
# OPENGENI_RIG_VERIFICATION_LEASE_OWNERSHIP_ENABLED=false
# Exact stable package used only when a custom rig lacks the stock-image CLI.
# OPENGENI_OGTOOL_PACKAGE_SPEC=@opengeni/ogtool@0.1.0

# Object storage for uploaded files. Local Docker uses S3-compatible Garage from
# docker-compose.yml unless MinIO is selected. The native backend always uses
# the pinned MinIO fixture because Garage is not installed on the host.
# OPENGENI_OBJECT_STORAGE_FIXTURE=minio
OPENGENI_OBJECT_STORAGE_BACKEND=s3-compatible
OPENGENI_OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:3900
OPENGENI_OBJECT_STORAGE_INTERNAL_ENDPOINT=http://garage:3900
OPENGENI_OBJECT_STORAGE_SANDBOX_ENDPOINT=http://garage:3900
OPENGENI_OBJECT_STORAGE_BUCKET=opengeni-files
OPENGENI_OBJECT_STORAGE_REGION=us-east-1
OPENGENI_OBJECT_STORAGE_S3_PROVIDER=Other
OPENGENI_OBJECT_STORAGE_ACCESS_KEY_ID=GK0123456789abcdef0123456789abcdef
OPENGENI_OBJECT_STORAGE_SECRET_ACCESS_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
OPENGENI_OBJECT_STORAGE_FORCE_PATH_STYLE=true

# Azure Blob production storage. Set OPENGENI_OBJECT_STORAGE_BACKEND=azure-blob and provide
# either a connection string or account name plus account key. The bucket value is the Azure container.
# OPENGENI_OBJECT_STORAGE_AZURE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
# OPENGENI_OBJECT_STORAGE_AZURE_ACCOUNT_NAME=...
# OPENGENI_OBJECT_STORAGE_AZURE_ACCOUNT_KEY=...
# OPENGENI_OBJECT_STORAGE_AZURE_ENDPOINT=https://account.blob.core.windows.net

# Native cloud object storage. Prefer workload identity in Kubernetes; static keys are optional.
# AWS S3:
# OPENGENI_OBJECT_STORAGE_BACKEND=aws-s3
# OPENGENI_OBJECT_STORAGE_BUCKET=opengeni-files
# OPENGENI_OBJECT_STORAGE_REGION=us-east-1
# GCS:
# OPENGENI_OBJECT_STORAGE_BACKEND=gcs
# OPENGENI_OBJECT_STORAGE_BUCKET=opengeni-files
# OPENGENI_OBJECT_STORAGE_GCS_PROJECT_ID=opengeni-project
# OPENGENI_OBJECT_STORAGE_GCS_KEY_FILENAME=/var/run/secrets/gcp/key.json
# OPENGENI_OBJECT_STORAGE_GCS_CREDENTIALS_JSON={"type":"service_account",...}

# Document indexing. V1 retrieval is semantic-only: LiteParse -> chunks -> embeddings -> pgvector.
OPENGENI_DOCUMENT_PARSER=liteparse
OPENGENI_DOCUMENT_CHUNK_SIZE=1200
OPENGENI_DOCUMENT_CHUNK_OVERLAP=160
OPENGENI_DOCUMENT_EMBEDDING_PROVIDER=openai
OPENGENI_DOCUMENT_EMBEDDING_MODEL=text-embedding-3-large
OPENGENI_DOCUMENT_EMBEDDING_DIMENSIONS=3072
# OPENGENI_DOCUMENT_EMBEDDING_API_KEY=sk-...
# OPENGENI_DOCUMENT_EMBEDDING_BASE_URL=https://api.openai.com/v1

# Knowledge-drop auto-curation (name/summarize/categorize/file dropped documents).
# Provider `openai` uses a chat model (defaults to the embedding credentials);
# `heuristic` needs no network/key; `none` disables curation.
OPENGENI_DOCUMENT_CURATION_PROVIDER=openai
OPENGENI_DOCUMENT_CURATION_MODEL=gpt-4o-mini
# OPENGENI_DOCUMENT_CURATION_API_KEY=sk-...
# OPENGENI_DOCUMENT_CURATION_BASE_URL=https://api.openai.com/v1

# Explicit OpenGeni git identity used inside sandboxes. GitHub App runs default to the app bot identity.
# OPENGENI_GIT_AUTHOR_NAME=OpenGeni Agent
# OPENGENI_GIT_AUTHOR_EMAIL=opengeni-agent@example.com
# OPENGENI_GIT_COMMITTER_NAME=OpenGeni Agent
# OPENGENI_GIT_COMMITTER_EMAIL=opengeni-agent@example.com

# Actual sandbox credentials. Prefer short-lived credentials.
# When the azure preparation profile is enabled and ARM/AZURE service-principal vars are present,
# the worker pre-authenticates normal Azure CLI inside the sandbox before the agent starts.
# ARM_CLIENT_ID=...
# ARM_CLIENT_SECRET=...
# ARM_TENANT_ID=...
# ARM_SUBSCRIPTION_ID=...
# AZURE_CLIENT_ID=...
# AZURE_CLIENT_SECRET=...
# AZURE_TENANT_ID=...
# AZURE_SUBSCRIPTION_ID=...
# GH_TOKEN=...
# GITHUB_TOKEN=...

# GitHub App manifest flow.
# OPENGENI_GITHUB_APP_MANIFEST_BASE_URL=https://YOUR_DOMAIN
# OPENGENI_GITHUB_APP_MANIFEST_STATE_SECRET=change-me
# OPENGENI_GITHUB_APP_ID=
# OPENGENI_GITHUB_CLIENT_ID=
# OPENGENI_GITHUB_CLIENT_SECRET=
# OPENGENI_GITHUB_APP_SLUG=
# OPENGENI_GITHUB_WEBHOOK_SECRET=
# OPENGENI_GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# Optional deployment-owned GitHub App for the one-click OpenGeni Lens PR-review flow.
# It reuses OPENGENI_GITHUB_APP_MANIFEST_STATE_SECRET for durable signed setup state.
# It also requires OPENGENI_ENVIRONMENTS_ENCRYPTION_KEY to protect webhook authority at rest.
# Configure its setup URL as ${OPENGENI_PUBLIC_BASE_URL}/v1/pr-review/github/setup,
# callback URL as ${OPENGENI_PUBLIC_BASE_URL}/v1/pr-review/github/oauth/callback,
# and webhook URL as ${OPENGENI_PUBLIC_BASE_URL}/v1/webhooks/pr-review/github.
# OPENGENI_PR_REVIEW_GITHUB_APP_ID=
# OPENGENI_PR_REVIEW_GITHUB_CLIENT_ID=
# OPENGENI_PR_REVIEW_GITHUB_CLIENT_SECRET=
# OPENGENI_PR_REVIEW_GITHUB_APP_SLUG=
# OPENGENI_PR_REVIEW_GITHUB_WEBHOOK_SECRET=
# OPENGENI_PR_REVIEW_GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
