diff --git a/src/connection.js b/src/connection.js
--- a/src/connection.js
+++ b/src/connection.js
@@ -157,6 +157,13 @@
     if (terminated)
       return queryError(q, Errors.connection('CONNECTION_DESTROYED', options))
 
+    // A transaction callback can outlive the physical connection. Reject its
+    // late query before build/write (and the catch path's Sync write).
+    if (!socket) {
+      queryError(q, Errors.connection('CONNECTION_CLOSED', options))
+      return true
+    }
+
     if (stream)
       return queryError(q, Errors.generic('COPY_IN_PROGRESS', 'You cannot execute queries during copy'))
 
@@ -252,10 +259,16 @@
   }
 
   function nextWrite(fn) {
-    const x = socket.write(chunk, fn)
+    const buffer = chunk
     nextWriteTimer !== null && clearImmediate(nextWriteTimer)
     chunk = nextWriteTimer = null
-    return x
+    if (!socket) {
+      const err = Errors.connection('CONNECTION_CLOSED', options)
+      error(err)
+      fn && fn(err)
+      return false
+    }
+    return buffer ? socket.write(buffer, fn) : true
   }
 
   function connectTimedOut() {
@@ -287,6 +300,11 @@
 
     socket.removeAllListeners()
     socket = tls.connect(options)
+    // Bun's native TLS upgrade still pushes wire bytes to the original TCP
+    // readable stream. No consumer remains after removeAllListeners(), so its
+    // queue otherwise retains every encrypted query result for the connection
+    // lifetime. Drain that duplicate stream only after TLS owns the transport.
+    if (typeof Bun !== 'undefined') options.socket.on('data', noop)
     socket.on('secureConnect', connected)
     socket.on('error', error)
     socket.on('close', closed)
@@ -438,6 +456,7 @@
     remaining = 0
     incomings = null
     clearImmediate(nextWriteTimer)
+    chunk = nextWriteTimer = null
     socket.removeListener('data', data)
     socket.removeListener('connect', connected)
     idleTimer.cancel()
@@ -451,6 +470,12 @@
       return reconnect()
 
     !hadError && (query || sent.length) && error(Errors.connection('CONNECTION_CLOSED', options, socket))
+    // The rejected query cannot receive ReadyForQuery from a dead backend.
+    // Release its drain obligation without replaying any bytes.
+    // Discard protocol state the dead backend cannot complete with ReadyForQuery.
+    query = results = errorResponse = null
+    result = new Result()
+    ended && (ended(), ending = ended = null)
     closedTime = performance.now()
     hadError && options.shared.retries++
     delay = (typeof backoff === 'function' ? backoff(options.shared.retries) : backoff) * 1000
@@ -561,4 +586,6 @@
       if (needsTypes) {
         initial.reserve && (initial = null)
-        return fetchArrayTypes()
+        // Startup catalog discovery is internal, not an application promise.
+        // Reject its waiting query without an unhandled async rejection.
+        return fetchArrayTypes().catch(error)
       }
