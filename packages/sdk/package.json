{
  "name": "@opengeni/sdk",
  "version": "3.1.1",
  "description": "Framework-agnostic TypeScript SDK for the OpenGeni API: typed client, session lifecycle, SSE event streaming with reconnect + replay-by-sequence, and proxy re-streaming helpers.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cloudgeni-ai/opengeni.git",
    "directory": "packages/sdk"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": [
    "./src/editable-artifacts-worker.ts",
    "./src/editable-artifacts/worker/browser-entry.ts",
    "./dist/editable-artifacts-worker.js"
  ],
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./core": {
      "types": "./src/core.ts",
      "default": "./src/core.ts"
    },
    "./browser": {
      "types": "./src/browser.ts",
      "default": "./src/browser.ts"
    },
    "./document-authority": {
      "types": "./src/document-authority.ts",
      "default": "./src/document-authority.ts"
    },
    "./accounts": {
      "types": "./src/accounts.ts",
      "default": "./src/accounts.ts"
    },
    "./artifacts": {
      "types": "./src/artifacts.ts",
      "default": "./src/artifacts.ts"
    },
    "./memory-slack": {
      "types": "./src/memory-slack.ts",
      "default": "./src/memory-slack.ts"
    },
    "./automations": {
      "types": "./src/automations.ts",
      "default": "./src/automations.ts"
    },
    "./pr-review": {
      "types": "./src/pr-review.ts",
      "default": "./src/pr-review.ts"
    },
    "./organization-private-session-settings": {
      "types": "./src/organization-private-session-settings.ts",
      "default": "./src/organization-private-session-settings.ts"
    },
    "./organization-user-setup": {
      "types": "./src/organization-user-setup.ts",
      "default": "./src/organization-user-setup.ts"
    },
    "./realtime": {
      "types": "./src/realtime.ts",
      "default": "./src/realtime.ts"
    },
    "./editable-artifacts": {
      "types": "./src/editable-artifacts.ts",
      "default": "./src/editable-artifacts.ts"
    },
    "./editable-artifacts/worker": {
      "types": "./src/editable-artifacts-worker.ts",
      "default": "./src/editable-artifacts-worker.ts"
    },
    "./interaction": {
      "types": "./src/interaction.ts",
      "default": "./src/interaction.ts"
    },
    "./codex-realtime-controller": {
      "types": "./src/codex-realtime-controller.ts",
      "default": "./src/codex-realtime-controller.ts"
    },
    "./gateway-realtime-transport": {
      "types": "./src/gateway-realtime-transport.ts",
      "default": "./src/gateway-realtime-transport.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "bun ../../scripts/build-typescript-package.ts",
    "prepublishOnly": "bash ../../scripts/prepublish-guard"
  },
  "dependencies": {
    "@opengeni/contracts": "workspace:*"
  },
  "devDependencies": {
    "@opengeni/artifact-kernel-wasm-document": "workspace:*",
    "@opengeni/artifact-kernel-wasm-presentation": "workspace:*",
    "@opengeni/artifact-kernel-wasm-spreadsheet": "workspace:*",
    "@opengeni/codex": "workspace:*",
    "@opengeni/deployment": "workspace:*",
    "fake-indexeddb": "^6.2.5",
    "tsup": "^8.5.0",
    "typescript": "7.0.2",
    "zod": "^4.2.1"
  },
  "engines": {
    "node": ">=18"
  }
}
