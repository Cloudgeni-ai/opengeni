{
  "key": "incident-log",
  "name": "Incident log",
  "description": "Log incidents with their impact, timeline and follow-ups.",
  "team": "Engineering",
  "package": {
    "format": "opengeni.app-package",
    "version": 1,
    "packageId": "9c0a5e3b-1f7d-8e24-a6b8-5d2c9e0f4b17",
    "packageVersion": "1.0.0",
    "exportedAt": "2026-11-22T00:00:00.000Z",
    "app": {
      "title": "Incident log",
      "description": "What broke, who it hit, and the follow-ups.",
      "html": "<!doctype html>\n<html lang='en'>\n<head>\n<meta charset='utf-8'>\n<meta name='viewport' content='width=device-width, initial-scale=1'>\n<title>Incident log</title>\n<link rel='stylesheet' href='/__opengeni/ui.css'>\n<style>\n/* The Opengeni look (/__opengeni/ui.css): its --og-* tokens and og-* classes. */\n.lead { margin: 0 0 20px; }\nform { display: grid; gap: 8px; margin-bottom: 20px; }\nform .og-button-primary { justify-self: start; }\n.row { display: flex; flex-wrap: wrap; gap: 8px; }\n.row > * { flex: 1 1 160px; }\ntextarea.og-input { resize: vertical; }\nnav { margin-bottom: 12px; }\nnav .og-button[aria-pressed='true'] { background: var(--og-surface-2); font-weight: 600; }\nul { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }\nli header { display: flex; gap: 12px; align-items: flex-start; justify-content: space-between; }\nli h2 { margin: 0 0 4px; font-size: 0.9375rem; line-height: 1.4; font-weight: 600; overflow-wrap: anywhere; }\nli .meta { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; }\nli p { margin: 8px 0 0; white-space: pre-wrap; overflow-wrap: anywhere; }\nli select.og-input { width: auto; flex: none; }\n</style>\n</head>\n<body class='og-app'>\n<main class='og-page'>\n<h1 class='og-title'>Incident log</h1>\n<p class='lead og-muted'>What broke, who it hit, and what we're doing so it doesn't happen again.</p>\n<form id='add' class='og-card'>\n<input class='og-input' name='title' required maxlength='200' placeholder='What happened?' aria-label='Title'>\n<div class='row'>\n<select class='og-input' name='severity' aria-label='Severity'><option value='sev1'>SEV1 · major outage</option><option value='sev2' selected>SEV2 · partial impact</option><option value='sev3'>SEV3 · minor</option></select>\n<input class='og-input' name='lead' maxlength='120' placeholder='Incident lead' aria-label='Incident lead'>\n</div>\n<textarea class='og-input' name='impact' maxlength='4000' placeholder='Impact: who and what was affected' aria-label='Impact'></textarea>\n<button type='submit' class='og-button og-button-primary'>Log incident</button>\n</form>\n<p id='status' class='og-muted' role='status'></p>\n<ul id='list'></ul>\n</main>\n<script src='/__opengeni/site-tools/client.js'></script>\n<script>\nconst STATUSES = [['investigating', 'Investigating'], ['mitigated', 'Mitigated'], ['resolved', 'Resolved']];\nconst statusLine = document.getElementById('status');\nconst list = document.getElementById('list');\nlet incidents = null;\nlet reloadTimer = null;\nlet reloadPending = false;\ntry { incidents = createOpenGeniSiteClient().data.collection('incidents'); } catch { statusLine.textContent = 'Open the saved app to keep incidents.'; }\nfunction field(record, name, placeholder) {\n  const area = document.createElement('textarea');\n  area.className = 'og-input';\n  area.maxLength = 4000;\n  area.placeholder = placeholder;\n  area.setAttribute('aria-label', `${placeholder} for ${record.data.title}`);\n  area.value = record.data[name] || '';\n  area.addEventListener('change', async () => {\n    try { await incidents.patch({ id: record.id }, { [name]: area.value.trim() }); statusLine.textContent = 'Saved.'; }\n    catch { statusLine.textContent = 'Couldn’t save that. Try again.'; }\n  });\n  return area;\n}\nfunction render(records, more) {\n  list.replaceChildren();\n  statusLine.textContent = records.length === 0 ? 'No incidents yet.' : more ? `Showing the newest ${records.length}.` : '';\n  for (const record of records) {\n    const item = document.createElement('li');\n    item.className = 'og-card';\n    const header = document.createElement('header');\n    const text = document.createElement('div');\n    const title = document.createElement('h2');\n    title.textContent = record.data.title;\n    const meta = document.createElement('div');\n    meta.className = 'meta og-subtle';\n    const chip = document.createElement('span');\n    chip.className = `og-badge${record.data.severity === 'sev1' ? ' og-badge-danger' : record.data.severity === 'sev2' ? ' og-badge-warning' : ''}`;\n    chip.textContent = String(record.data.severity || 'sev2').toUpperCase();\n    meta.append(chip, [record.data.started, record.data.lead].filter(Boolean).join(' · '));\n    text.append(title, meta);\n    const select = document.createElement('select');\n    select.className = 'og-input';\n    select.setAttribute('aria-label', `Status of ${record.data.title}`);\n    for (const [value, label] of STATUSES) select.add(new Option(label, value, false, value === record.data.status));\n    select.addEventListener('change', async () => {\n      select.disabled = true;\n      try { await incidents.patch({ id: record.id }, { status: select.value }); await load(); }\n      catch { statusLine.textContent = 'Couldn’t change the status. Try again.'; select.disabled = false; }\n    });\n    header.append(text, select);\n    item.append(header);\n    if (record.data.impact) {\n      const impact = document.createElement('p');\n      impact.textContent = record.data.impact;\n      item.append(impact);\n    }\n    const notes = document.createElement('div');\n    notes.style.cssText = 'display:grid;gap:8px;margin-top:10px';\n    notes.append(field(record, 'timeline', 'Timeline'), field(record, 'followUps', 'Follow-ups'));\n    item.append(notes);\n    list.append(item);\n  }\n}\nasync function load() {\n  if (!incidents) return;\n  try {\n    const page = await incidents.list({ sort: [{ field: '$createdAt', direction: 'desc' }], limit: 200 });\n    render(page.records, Boolean(page.nextCursor));\n  } catch { statusLine.textContent = 'Couldn’t load incidents. Try again in a moment.'; }\n}\n// Reload after teammates' changes, but not while someone is typing or choosing here.\nfunction scheduleLoad() {\n  clearTimeout(reloadTimer);\n  reloadTimer = setTimeout(() => {\n    if (list.contains(document.activeElement)) { reloadPending = true; return; }\n    void load();\n  }, 400);\n}\nlist.addEventListener('focusout', () => { if (reloadPending) { reloadPending = false; scheduleLoad(); } });\ndocument.getElementById('add').addEventListener('submit', async (event) => {\n  event.preventDefault();\n  if (!incidents) return;\n  const formEl = event.currentTarget;\n  const button = formEl.querySelector('button');\n  if (button.disabled) return;\n  const form = new FormData(formEl);\n  const now = new Date();\n  const entry = { title: String(form.get('title')).trim(), severity: String(form.get('severity')), lead: String(form.get('lead')).trim(), impact: String(form.get('impact')).trim(), status: 'investigating', started: `${now.toISOString().slice(0, 16).replace('T', ' ')} UTC`, timeline: '', followUps: '' };\n  if (!entry.title) return;\n  button.disabled = true;\n  try { await incidents.insert(entry, { idempotencyKey: crypto.randomUUID() }); formEl.reset(); await load(); }\n  catch { statusLine.textContent = 'Couldn’t log that incident. Try again.'; }\n  finally { button.disabled = false; }\n});\nif (incidents) { incidents.onChange(scheduleLoad); statusLine.textContent = 'Loading…'; }\nvoid load();\n</script>\n</body>\n</html>\n"
    },
    "tools": [],
