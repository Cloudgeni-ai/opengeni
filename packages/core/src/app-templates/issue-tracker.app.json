{
  "key": "issue-tracker",
  "name": "Issue tracker",
  "description": "Track bugs and tasks by status, priority and owner.",
  "team": "Engineering",
  "package": {
    "format": "opengeni.app-package",
    "version": 1,
    "packageId": "2b7e4f10-6c3d-8a52-b1e9-0d4f8a6c2e31",
    "packageVersion": "1.0.0",
    "exportedAt": "2026-11-22T00:00:00.000Z",
    "app": {
      "title": "Issue tracker",
      "description": "Bugs and tasks, by status, priority and owner.",
      "html": "<!doctype html>\n<html lang='en'>\n<head>\n<meta charset='utf-8'>\n<meta name='viewport' content='width=device-width, initial-scale=1'>\n<title>Issue tracker</title>\n<link rel='stylesheet' href='/__opengeni/ui.css'>\n<style>\n/* The Opengeni look (/__opengeni/ui.css): its --og-* tokens and og-* classes. */\n.lead { margin: 0 0 20px; }\nform { display: grid; gap: 8px; margin-bottom: 20px; }\nform .og-button-primary { justify-self: start; }\n.row { display: flex; flex-wrap: wrap; gap: 8px; }\n.row > * { flex: 1 1 160px; }\ntextarea.og-input { resize: vertical; }\nnav { margin-bottom: 12px; }\nnav .og-button[aria-pressed='true'] { background: var(--og-surface-2); font-weight: 600; }\nul { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }\nli header { display: flex; gap: 12px; align-items: flex-start; justify-content: space-between; }\nli h2 { margin: 0 0 4px; font-size: 0.9375rem; line-height: 1.4; font-weight: 600; overflow-wrap: anywhere; }\nli .meta { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; }\nli p { margin: 8px 0 0; white-space: pre-wrap; overflow-wrap: anywhere; }\nli select.og-input { width: auto; flex: none; }\n</style>\n</head>\n<body class='og-app'>\n<main class='og-page'>\n<h1 class='og-title'>Issue tracker</h1>\n<p class='lead og-muted'>Bugs and tasks, by status, priority and owner.</p>\n<form id='add' class='og-card'>\n<input class='og-input' name='title' required maxlength='200' placeholder='What needs doing?' aria-label='Title'>\n<textarea class='og-input' name='details' maxlength='4000' placeholder='Details, steps to reproduce, links' aria-label='Details'></textarea>\n<div class='row'>\n<select class='og-input' name='priority' aria-label='Priority'><option value='low'>Low</option><option value='medium' selected>Medium</option><option value='high'>High</option><option value='urgent'>Urgent</option></select>\n<input class='og-input' name='owner' maxlength='120' placeholder='Owner' aria-label='Owner'>\n</div>\n<button type='submit' class='og-button og-button-primary'>Add issue</button>\n</form>\n<nav id='filters' aria-label='Show'></nav>\n<p id='status' class='og-muted' role='status'></p>\n<ul id='list'></ul>\n</main>\n<script src='/__opengeni/site-tools/client.js'></script>\n<script>\nconst STATUSES = [['open', 'Open'], ['in_progress', 'In progress'], ['done', 'Done']];\nconst PRIORITY = { urgent: 0, high: 1, medium: 2, low: 3 };\nconst statusLine = document.getElementById('status');\nconst list = document.getElementById('list');\nconst filters = document.getElementById('filters');\nlet issues = null;\nlet shown = 'open';\nlet all = [];\nlet loaded = false;\nlet more = false;\nlet reloadTimer = null;\nlet reloadPending = false;\ntry { issues = createOpenGeniSiteClient().data.collection('issues'); } catch { statusLine.textContent = 'Open the saved app to keep issues.'; }\nfor (const [value, label] of [...STATUSES, ['all', 'All']]) {\n  const button = document.createElement('button');\n  button.className = 'og-button';\n  button.type = 'button';\n  button.dataset.value = value;\n  button.addEventListener('click', () => { shown = value; render(); });\n  filters.append(button);\n}\nfunction label(value) { return (STATUSES.find(([key]) => key === value) || [value, value])[1]; }\nfunction render() {\n  for (const button of filters.children) {\n    const value = button.dataset.value;\n    const count = value === 'all' ? all.length : all.filter((record) => record.data.status === value).length;\n    button.textContent = `${value === 'all' ? 'All' : label(value)} (${count})`;\n    button.setAttribute('aria-pressed', String(value === shown));\n  }\n  const records = all\n    .filter((record) => shown === 'all' || record.data.status === shown)\n    .sort((a, b) => (PRIORITY[a.data.priority] ?? 9) - (PRIORITY[b.data.priority] ?? 9));\n  list.replaceChildren();\n  statusLine.textContent = !loaded\n    ? (issues ? 'Loading…' : statusLine.textContent)\n    : records.length === 0\n      ? (all.length === 0 ? 'No issues yet.' : 'Nothing here.')\n      : more ? `Showing the newest ${all.length}.` : '';\n  for (const record of records) {\n    const item = document.createElement('li');\n    item.className = 'og-card';\n    const header = document.createElement('header');\n    const text = document.createElement('div');\n    const title = document.createElement('h2');\n    title.textContent = record.data.title;\n    const meta = document.createElement('div');\n    meta.className = 'meta og-subtle';\n    const chip = document.createElement('span');\n    chip.className = `og-badge${record.data.priority === 'urgent' || record.data.priority === 'high' ? ' og-badge-danger' : ''}`;\n    chip.textContent = record.data.priority || 'medium';\n    meta.append(chip, [record.data.owner, record.data.opened].filter(Boolean).join(' · '));\n    text.append(title, meta);\n    const select = document.createElement('select');\n    select.className = 'og-input';\n    select.setAttribute('aria-label', `Status of ${record.data.title}`);\n    for (const [value, text] of STATUSES) select.add(new Option(text, value, false, value === record.data.status));\n    select.addEventListener('change', async () => {\n      select.disabled = true;\n      try { await issues.patch({ id: record.id }, { status: select.value }); await load(); }\n      catch { statusLine.textContent = 'Couldn’t change the status. Try again.'; select.disabled = false; }\n    });\n    header.append(text, select);\n    item.append(header);\n    if (record.data.details) {\n      const details = document.createElement('p');\n      details.textContent = record.data.details;\n      item.append(details);\n    }\n    list.append(item);\n  }\n}\nasync function load() {\n  if (!issues) return;\n  try {\n    // Pages of 200, up to 2,000 issues.\n    const records = [];\n    let cursor = null;\n    do {\n      const page = await issues.list({ sort: [{ field: '$createdAt', direction: 'desc' }], limit: 200, cursor });\n      records.push(...page.records);\n      cursor = page.nextCursor;\n    } while (cursor && records.length < 2000);\n    all = records;\n    more = Boolean(cursor);\n    loaded = true;\n    render();\n  } catch { statusLine.textContent = 'Couldn’t load issues. Try again in a moment.'; }\n}\n// Reload after teammates' changes, but not while someone is choosing a status here.\nfunction scheduleLoad() {\n  clearTimeout(reloadTimer);\n  reloadTimer = setTimeout(() => {\n    if (list.contains(document.activeElement) && document.activeElement.tagName === 'SELECT') { reloadPending = true; return; }\n    void load();\n  }, 400);\n}\nlist.addEventListener('focusout', () => { if (reloadPending) { reloadPending = false; scheduleLoad(); } });\ndocument.getElementById('add').addEventListener('submit', async (event) => {\n  event.preventDefault();\n  if (!issues) return;\n  const formEl = event.currentTarget;\n  const button = formEl.querySelector('button');\n  if (button.disabled) return;\n  const form = new FormData(formEl);\n  const entry = { title: String(form.get('title')).trim(), details: String(form.get('details')).trim(), priority: String(form.get('priority')), owner: String(form.get('owner')).trim(), status: 'open', opened: new Date().toISOString().slice(0, 10) };\n  if (!entry.title) return;\n  button.disabled = true;\n  try { await issues.insert(entry, { idempotencyKey: crypto.randomUUID() }); formEl.reset(); shown = 'open'; await load(); }\n  catch { statusLine.textContent = 'Couldn’t save that issue. Try again.'; }\n  finally { button.disabled = false; }\n});\nif (issues) issues.onChange(scheduleLoad);\nrender();\nvoid load();\n</script>\n</body>\n</html>\n"
    },
    "tools": [],
    "data": {
      "collections": [
        {
          "name": "issues",
          "accessMode": "shared"
        }
      ]
    },
    "sql": {
      "migrations": [],
      "queries": []
    },
    "syncs": [],
    "sidebar": [
