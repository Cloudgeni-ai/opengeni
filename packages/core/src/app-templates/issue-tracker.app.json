{
  "key": "issue-tracker",
  "name": "Issue tracker",
  "description": "Track bugs and tasks by status, priority and owner.",
  "team": "Engineering",
  "package": {
    "format": "opengeni.app-package",
    "version": 1,
    "exportedAt": "2026-11-22T00:00:00.000Z",
    "app": {
      "title": "Issue tracker",
      "description": "Bugs and tasks, by status, priority and owner.",
      "html": "<!doctype html>\n<html lang='en'>\n<head>\n<meta charset='utf-8'>\n<meta name='viewport' content='width=device-width, initial-scale=1'>\n<title>Issue tracker</title>\n<style>\n:root { color-scheme: light dark; --line: color-mix(in srgb, currentColor 14%, transparent); --muted: color-mix(in srgb, currentColor 62%, transparent); --soft: color-mix(in srgb, currentColor 6%, transparent); --accent: #3b5bdb; }\n* { box-sizing: border-box; }\nbody { margin: 0; font: 15px/1.5 system-ui, sans-serif; }\nmain { max-width: 820px; margin: 0 auto; padding: 32px 20px 64px; }\nh1 { font-size: 22px; margin: 0 0 4px; }\np.lead { margin: 0 0 24px; color: var(--muted); }\nform { display: grid; gap: 10px; padding: 16px; border: 1px solid var(--line); border-radius: 12px; margin-bottom: 24px; }\n.row { display: flex; flex-wrap: wrap; gap: 10px; }\n.row > * { flex: 1 1 160px; }\ninput, textarea, select, button { font: inherit; color: inherit; }\ninput, textarea, select { width: 100%; padding: 9px 11px; border: 1px solid var(--line); border-radius: 8px; background: transparent; }\nselect option { color: initial; }\ntextarea { min-height: 64px; resize: vertical; }\nbutton { padding: 8px 14px; border: 1px solid var(--line); border-radius: 8px; background: transparent; cursor: pointer; }\nbutton.primary { justify-self: start; border-color: var(--accent); background: var(--accent); color: #fff; }\nbutton:disabled { opacity: .6; cursor: default; }\nnav { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 14px; }\nnav button[aria-pressed='true'] { background: var(--soft); font-weight: 600; }\nul { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }\nli { padding: 14px 16px; border: 1px solid var(--line); border-radius: 12px; }\nli header { display: flex; gap: 12px; align-items: flex-start; justify-content: space-between; }\nli h2 { font-size: 16px; margin: 0 0 2px; overflow-wrap: anywhere; }\nli .meta { font-size: 13px; color: var(--muted); }\nli p { margin: 8px 0 0; white-space: pre-wrap; overflow-wrap: anywhere; }\nli select { width: auto; padding: 4px 8px; font-size: 13px; }\n.chip { display: inline-block; padding: 1px 8px; border-radius: 999px; background: var(--soft); font-size: 12px; margin-right: 6px; }\n.chip.high, .chip.urgent, .chip.sev1 { background: color-mix(in srgb, #e03131 18%, transparent); }\n.note { color: var(--muted); }\n</style>\n</head>\n<body>\n<main>\n<h1>Issue tracker</h1>\n<p class='lead'>Bugs and tasks, by status, priority and owner.</p>\n<form id='add'>\n<input name='title' required maxlength='200' placeholder='What needs doing?' aria-label='Title'>\n<textarea name='details' maxlength='4000' placeholder='Details, steps to reproduce, links' aria-label='Details'></textarea>\n<div class='row'>\n<select name='priority' aria-label='Priority'><option value='low'>Low</option><option value='medium' selected>Medium</option><option value='high'>High</option><option value='urgent'>Urgent</option></select>\n<input name='owner' maxlength='120' placeholder='Owner' aria-label='Owner'>\n</div>\n<button type='submit' class='primary'>Add issue</button>\n</form>\n<nav id='filters' aria-label='Show'></nav>\n<p id='status' class='note' role='status'></p>\n<ul id='list'></ul>\n</main>\n<script src='/__opengeni/site-tools/client.js'></script>\n<script>\nconst STATUSES = [['open', 'Open'], ['in_progress', 'In progress'], ['done', 'Done']];\nconst PRIORITY = { urgent: 0, high: 1, medium: 2, low: 3 };\nconst statusLine = document.getElementById('status');\nconst list = document.getElementById('list');\nconst filters = document.getElementById('filters');\nlet issues = null;\nlet shown = 'open';\nlet all = [];\ntry { issues = createOpenGeniSiteClient().data.collection('issues'); } catch { statusLine.textContent = 'Open the saved app to keep issues.'; }\nfor (const [value, label] of [...STATUSES, ['all', 'All']]) {\n  const button = document.createElement('button');\n  button.type = 'button';\n  button.dataset.value = value;\n  button.addEventListener('click', () => { shown = value; render(); });\n  filters.append(button);\n}\nfunction label(value) { return (STATUSES.find(([key]) => key === value) || [value, value])[1]; }\nfunction render() {\n  for (const button of filters.children) {\n    const value = button.dataset.value;\n    const count = value === 'all' ? all.length : all.filter((record) => record.data.status === value).length;\n    button.textContent = `${value === 'all' ? 'All' : label(value)} (${count})`;\n    button.setAttribute('aria-pressed', String(value === shown));\n  }\n  const records = all\n    .filter((record) => shown === 'all' || record.data.status === shown)\n    .sort((a, b) => (PRIORITY[a.data.priority] ?? 9) - (PRIORITY[b.data.priority] ?? 9));\n  list.replaceChildren();\n  statusLine.textContent = records.length === 0 ? (all.length === 0 ? 'No issues yet.' : 'Nothing here.') : '';\n  for (const record of records) {\n    const item = document.createElement('li');\n    const header = document.createElement('header');\n    const text = document.createElement('div');\n    const title = document.createElement('h2');\n    title.textContent = record.data.title;\n    const meta = document.createElement('div');\n    meta.className = 'meta';\n    const chip = document.createElement('span');\n    chip.className = `chip ${record.data.priority}`;\n    chip.textContent = record.data.priority || 'medium';\n    meta.append(chip, [record.data.owner, record.data.opened].filter(Boolean).join(' · '));\n    text.append(title, meta);\n    const select = document.createElement('select');\n    select.setAttribute('aria-label', `Status of ${record.data.title}`);\n    for (const [value, text] of STATUSES) select.add(new Option(text, value, false, value === record.data.status));\n    select.addEventListener('change', async () => {\n      select.disabled = true;\n      try { await issues.patch({ id: record.id }, { status: select.value }); await load(); }\n      catch { statusLine.textContent = 'Couldn’t change the status. Try again.'; select.disabled = false; }\n    });\n    header.append(text, select);\n    item.append(header);\n    if (record.data.details) {\n      const details = document.createElement('p');\n      details.textContent = record.data.details;\n      item.append(details);\n    }\n    list.append(item);\n  }\n}\nasync function load() {\n  if (!issues) return;\n  try {\n    // Pages of 200, up to 2,000 issues.\n    const records = [];\n    let cursor = null;\n    do {\n      const page = await issues.list({ sort: [{ field: '$createdAt', direction: 'desc' }], limit: 200, cursor });\n      records.push(...page.records);\n      cursor = page.nextCursor;\n    } while (cursor && records.length < 2000);\n    all = records;\n    render();\n  } catch { statusLine.textContent = 'Couldn’t load issues. Try again in a moment.'; }\n}\ndocument.getElementById('add').addEventListener('submit', async (event) => {\n  event.preventDefault();\n  if (!issues) return;\n  const formEl = event.currentTarget;\n  const button = formEl.querySelector('button');\n  if (button.disabled) return;\n  const form = new FormData(formEl);\n  const entry = { title: String(form.get('title')).trim(), details: String(form.get('details')).trim(), priority: String(form.get('priority')), owner: String(form.get('owner')).trim(), status: 'open', opened: new Date().toISOString().slice(0, 10) };\n  if (!entry.title) return;\n  button.disabled = true;\n  try { await issues.insert(entry, { idempotencyKey: crypto.randomUUID() }); formEl.reset(); shown = 'open'; await load(); }\n  catch { statusLine.textContent = 'Couldn’t save that issue. Try again.'; }\n  finally { button.disabled = false; }\n});\nif (issues) issues.onChange(() => void load());\nrender();\nvoid load();\n</script>\n</body>\n</html>\n"
    },
    "tools": [],
    "data": {
      "collections": [
        {
          "name": "issues",
          "accessMode": "shared"
        }
      ]
    },
    "sql": {
      "migrations": [],
      "queries": []
    },
    "syncs": [],
    "sidebar": [
      {
        "label": "Issue tracker"
      }
    ]
  }
