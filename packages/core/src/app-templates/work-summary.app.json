        "files": [
          {
            "path": "SKILL.md",
            "content": "---\nname: work-summary\ndescription: Adds what got done to the Work summary app. Use after finishing real work (shipped a change, fixed a problem, made a decision, delivered something) in a workspace with that app.\n---\n\n# Work summary\n\nThe Work summary app (collection `entries`) lists what got done. Add an entry when you finish a piece of work; skip questions, research and work still in progress.\n\n1. Find the app: the app titled \"Work summary\" in this workspace.\n2. Check today's entries first (`app_data_query`, `date` equal to today) and don't add the same work twice; update an entry instead.\n3. Add one entry with `app_data_write` (`insert`):\n   - `title`: what was done, in a few plain words.\n   - `summary`: one or two sentences on what changed and why it matters.\n   - `kind`: `shipped`, `fixed`, `decided` or `other`.\n   - `link`: the PR, document or chat URL, when there is one.\n   - `by`: who did it (the person, or the agent and who it worked for).\n   - `date`: today, as YYYY-MM-DD.\n"
          }
        ]
      }
    ],
    "automations": [
      {
        "name": "Update the work summary",
        "prompt": "Add the work finished in this workspace over the last day to the Work summary app (id {{appId}}), following the work-summary Skill. Look at recent chats and their results. Add nothing when there is nothing new.",
        "schedule": {
          "type": "calendar",
          "timeZone": "UTC",
          "hour": 17,
          "minute": 0,
          "daysOfWeek": ["MONDAY", "TUESDAY", "WEDNESDAY", "THURSDAY", "FRIDAY"]
        }
      }
    ]
  }
