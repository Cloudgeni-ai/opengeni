  "package": {
    "format": "opengeni.app-package",
    "version": 1,
    "packageId": "4e8b2d6f-3a1c-8b97-8c45-7f0e1d3a9b62",
    "packageVersion": "1.0.0",
    "exportedAt": "2026-11-22T00:00:00.000Z",
    "app": {
      "title": "Feedback board",
      "description": "Feature requests and ideas, with votes.",
      "html": "<!doctype html>\n<html lang='en'>\n<head>\n<meta charset='utf-8'>\n<meta name='viewport' content='width=device-width, initial-scale=1'>\n<title>Feedback board</title>\n<link rel='stylesheet' href='/__opengeni/ui.css'>\n<style>\n/* The Opengeni look (/__opengeni/ui.css): its --og-* tokens and og-* classes. */\n.lead { margin: 0 0 20px; }\nform { display: grid; gap: 8px; margin-bottom: 20px; }\nform .og-button-primary { justify-self: start; }\n.row { display: flex; flex-wrap: wrap; gap: 8px; }\n.row > * { flex: 1 1 160px; }\ntextarea.og-input { resize: vertical; }\nnav { margin-bottom: 12px; }\nnav .og-button[aria-pressed='true'] { background: var(--og-surface-2); font-weight: 600; }\nul { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }\nli header { display: flex; gap: 12px; align-items: flex-start; justify-content: space-between; }\nli h2 { margin: 0 0 4px; font-size: 0.9375rem; line-height: 1.4; font-weight: 600; overflow-wrap: anywhere; }\nli .meta { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; }\nli p { margin: 8px 0 0; white-space: pre-wrap; overflow-wrap: anywhere; }\nli select.og-input { width: auto; flex: none; }\n.vote { display: grid; justify-items: center; gap: 0; min-width: 56px; height: auto; padding: 6px 8px; }\n.vote strong { font-size: 1rem; line-height: 1.25; }\n.vote[aria-pressed='true'] { background: var(--og-primary); border-color: var(--og-primary-edge); color: var(--og-primary-ink); }\n</style>\n</head>\n<body class='og-app'>\n<main class='og-page'>\n<h1 class='og-title'>Feedback board</h1>\n<p class='lead og-muted'>Feature requests and ideas. Vote for the ones that matter to you.</p>\n<form id='add' class='og-card'>\n<input class='og-input' name='title' required maxlength='200' placeholder='Your idea or request' aria-label='Title'>\n<textarea class='og-input' name='details' maxlength='4000' placeholder='Why it matters, who asked for it' aria-label='Details'></textarea>\n<button type='submit' class='og-button og-button-primary'>Add request</button>\n</form>\n<p id='status' class='og-muted' role='status'></p>\n<ul id='list'></ul>\n</main>\n<script src='/__opengeni/site-tools/client.js'></script>\n<script>\nconst STATUSES = [['new', 'New'], ['planned', 'Planned'], ['in_progress', 'In progress'], ['done', 'Done'], ['declined', 'Declined']];\nconst statusLine = document.getElementById('status');\nconst list = document.getElementById('list');\nlet requests = null;\nlet myVotes = null;\nlet data = null;\nlet reloadTimer = null;\nlet reloadPending = false;\ntry {\n  data = createOpenGeniSiteClient().data;\n  requests = data.collection('requests');\n  myVotes = data.collection('votes');\n} catch { statusLine.textContent = 'Open the saved app to keep requests.'; }\nfunction votesLabel(count) { return count === 1 ? 'vote' : 'votes'; }\nfunction render(records, voted, more) {\n  list.replaceChildren();\n  statusLine.textContent = records.length === 0\n    ? 'No requests yet.'\n    : [more ? `Showing the ${records.length} most voted.` : '', voted ? '' : 'Voting is unavailable right now.'].filter(Boolean).join(' ');\n  for (const record of records) {\n    const item = document.createElement('li');\n    item.className = 'og-card';\n    const header = document.createElement('header');\n    header.style.justifyContent = 'flex-start';\n    const vote = document.createElement('button');\n    vote.type = 'button';\n    vote.className = 'og-button vote';\n    // The viewer's own vote record for this request, if they voted.\n    const mine = voted ? voted.get(record.id) : undefined;\n    const total = Math.max(0, Number(record.data.votes) || 0);\n    // Without the viewer's own votes we can't tell a vote from a second vote.\n    vote.disabled = !voted;\n    vote.setAttribute('aria-pressed', String(Boolean(mine)));\n    vote.setAttribute('aria-label', `${mine ? 'Remove your vote for' : 'Vote for'} ${record.data.title}, ${total} ${votesLabel(total)}`);\n    const count = document.createElement('strong');\n    count.textContent = String(total);\n    vote.append(count, votesLabel(total));\n    vote.addEventListener('click', async () => {\n      vote.disabled = true;\n      try {\n        // The vote and the count change together, or not at all.\n        await data.batch(mine\n          ? [{ op: 'delete', collection: 'votes', id: mine }, { op: 'increment', collection: 'requests', id: record.id, field: 'votes', by: -1 }]\n          : [{ op: 'insert', collection: 'votes', data: { request: record.id } }, { op: 'increment', collection: 'requests', id: record.id, field: 'votes', by: 1 }]);\n        await load();\n      } catch { statusLine.textContent = 'Couldn’t save your vote. Try again.'; vote.disabled = false; }\n    });\n    const text = document.createElement('div');\n    text.style.flex = '1';\n    const title = document.createElement('h2');\n    title.textContent = record.data.title;\n    const meta = document.createElement('div');\n    meta.className = 'meta og-subtle';\n    meta.textContent = record.data.added || '';\n    text.append(title, meta);\n    if (record.data.details) {\n      const details = document.createElement('p');\n      details.textContent = record.data.details;\n      text.append(details);\n    }\n    const select = document.createElement('select');\n    select.className = 'og-input';\n    select.setAttribute('aria-label', `Status of ${record.data.title}`);\n    for (const [value, label] of STATUSES) select.add(new Option(label, value, false, value === record.data.status));\n    select.addEventListener('change', async () => {\n      select.disabled = true;\n      try { await requests.patch({ id: record.id }, { status: select.value }); await load(); }\n      catch { statusLine.textContent = 'Couldn’t change the status. Try again.'; select.disabled = false; }\n    });\n    header.append(vote, text, select);\n    item.append(header);\n    list.append(item);\n  }\n}\n// All of the viewer's own votes, a page at a time; null when they can't be read.\nasync function ownVotes() {\n  try {\n    const voted = new Map();\n    let cursor = null;\n    do {\n      const page = await myVotes.list({ scope: 'own', limit: 200, cursor });\n      for (const vote of page.records) voted.set(vote.data.request, vote.id);\n      cursor = page.nextCursor;\n    } while (cursor);\n    return voted;\n  } catch { return null; }\n}\nasync function load() {\n  if (!requests) return;\n  try {\n    const [page, voted] = await Promise.all([\n      requests.list({ sort: [{ field: 'votes', direction: 'desc' }, { field: '$createdAt', direction: 'desc' }], limit: 200 }),\n      ownVotes(),\n    ]);\n    render(page.records, voted, Boolean(page.nextCursor));\n  } catch { statusLine.textContent = 'Couldn’t load requests. Try again in a moment.'; }\n}\n// Reload after others' changes, but not while someone is choosing a status here.\nfunction scheduleLoad() {\n  clearTimeout(reloadTimer);\n  reloadTimer = setTimeout(() => {\n    if (list.contains(document.activeElement) && document.activeElement.tagName === 'SELECT') { reloadPending = true; return; }\n    void load();\n  }, 400);\n}\nlist.addEventListener('focusout', () => { if (reloadPending) { reloadPending = false; scheduleLoad(); } });\ndocument.getElementById('add').addEventListener('submit', async (event) => {\n  event.preventDefault();\n  if (!requests) return;\n  const formEl = event.currentTarget;\n  const button = formEl.querySelector('button');\n  if (button.disabled) return;\n  const form = new FormData(formEl);\n  const entry = { title: String(form.get('title')).trim(), details: String(form.get('details')).trim(), status: 'new', votes: 0, added: new Date().toISOString().slice(0, 10) };\n  if (!entry.title) return;\n  button.disabled = true;\n  try { await requests.insert(entry, { idempotencyKey: crypto.randomUUID() }); formEl.reset(); await load(); }\n  catch { statusLine.textContent = 'Couldn’t save that request. Try again.'; }\n  finally { button.disabled = false; }\n});\nif (requests) requests.onChange(scheduleLoad);\nstatusLine.textContent = requests ? 'Loading…' : statusLine.textContent;\nvoid load();\n</script>\n</body>\n</html>\n"
    },
