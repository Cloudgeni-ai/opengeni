{
  "name": "@opengeni/contracts",
  "version": "0.39.4",
  "description": "Shared zod schemas and wire-contract types for the OpenGeni API.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cloudgeni-ai/opengeni.git",
    "directory": "packages/contracts"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./slack-bot-scopes": {
      "types": "./src/slack-bot-scopes.ts",
      "default": "./src/slack-bot-scopes.ts"
    },
    "./google-drive": {
      "types": "./src/google-drive.ts",
      "default": "./src/google-drive.ts"
    },
    "./connector-destinations": {
      "types": "./src/connector-destinations.ts",
      "default": "./src/connector-destinations.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "bun ../../scripts/build-typescript-package.ts",
    "prepublishOnly": "bash ../../scripts/prepublish-guard"
  },
  "dependencies": {
    "@noble/hashes": "^1.8.0",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=18"
  }
}
