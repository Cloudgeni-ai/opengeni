{
  "name": "@opengeni/desktop",
  "version": "0.1.3",
  "private": true,
  "description": "Electron kit for Opengeni desktop apps: several accounts on several servers, the server's own web app in a native window, native notifications, deep links, the menu bar item, updates, and one-click connection of the computer it runs on.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cloudgeni-ai/opengeni.git",
    "directory": "packages/desktop"
  },
  "type": "module",
  "main": "./src/main/index.ts",
  "types": "./src/main/index.ts",
  "exports": {
    ".": {
      "types": "./src/main/index.ts",
      "default": "./src/main/index.ts"
    },
    "./contract": {
      "types": "./src/contract.ts",
      "default": "./src/contract.ts"
    },
    "./mac-login-agent": {
      "types": "./src/main/mac-login-agent.ts",
      "default": "./src/main/mac-login-agent.ts"
    },
    "./preload": {
      "types": "./src/preload/content.ts",
      "default": "./src/preload/content.ts"
    },
    "./preload/welcome": {
      "types": "./src/preload/welcome.ts",
      "default": "./src/preload/welcome.ts"
    }
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@noble/hashes": "1.8.0",
    "@opengeni/sdk": "workspace:*"
  },
  "devDependencies": {
    "electron": "44.7.2",
    "electron-updater": "6.8.9"
  },
  "peerDependencies": {
    "electron": ">=44",
    "electron-updater": ">=6"
  }
}
