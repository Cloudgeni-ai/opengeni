{
  "name": "@opengeni/ogtool",
  "version": "0.3.2",
  "description": "Codemode CLI and typed client entrypoint for an OpenGeni execution attempt.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cloudgeni-ai/opengeni.git",
    "directory": "packages/ogtool"
  },
  "bin": {
    "ogtool": "./dist/bin/ogtool.cjs"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "build": "bun build.ts",
    "prepublishOnly": "bash ../../scripts/prepublish-guard"
  },
  "dependencies": {
    "@opengeni/codemode": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=18"
  }
}
