{
  "name": "@opengeni/config",
  "version": "1.4.4",
  "description": "Opengeni runtime configuration: settings resolution, deployment knobs, and config validation shared across the server packages.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cloudgeni-ai/opengeni.git",
    "directory": "packages/config"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    "./server-native-artifact": {
      "types": "./src/server-native-artifact.ts",
      "default": "./src/server-native-artifact.ts"
    },
    "./server-source-identity": {
      "types": "./src/server-source-identity.ts",
      "default": "./src/server-source-identity.ts"
    },
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "bun ../../scripts/build-typescript-package.ts",
    "prepublishOnly": "bash ../../scripts/prepublish-guard"
  },
  "dependencies": {
    "@opengeni/codex": "workspace:*",
    "@opengeni/contracts": "workspace:*",
    "@opengeni/xai-subscription": "workspace:*",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=18"
  }
}
