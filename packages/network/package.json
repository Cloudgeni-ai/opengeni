{
  "name": "@opengeni/network",
  "version": "5.4.2",
  "description": "DNS-pinned outbound HTTP transport and shared MCP OAuth discovery primitives.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cloudgeni-ai/opengeni.git",
    "directory": "packages/network"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    "./azure-entra": {
      "types": "./src/azure-entra.ts",
      "default": "./src/azure-entra.ts"
    },
    "./responses-websocket": {
      "types": "./src/responses-websocket.ts",
      "default": "./src/responses-websocket.ts"
    },
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "bun ../../scripts/build-typescript-package.ts",
    "typecheck": "tsrs --noEmit",
    "prepublishOnly": "bash ../../scripts/prepublish-guard"
  },
  "dependencies": {
    "@azure/msal-node": "5.6.0",
    "undici": "^6.21.3",
    "ws": "8.21.1"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "tsup": "^8.5.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=18"
  }
}
