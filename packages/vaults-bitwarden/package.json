{
  "name": "@opengeni/vaults-bitwarden",
  "version": "5.2.1",
  "description": "Bitwarden and Vaultwarden provider for Opengeni vaults. Talks to the server's client API with the account's personal API key and decrypts locally; the master password is used once at setup and never stored.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cloudgeni-ai/opengeni.git",
    "directory": "packages/vaults-bitwarden"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "bun ../../scripts/build-typescript-package.ts",
    "typecheck": "tsrs --noEmit",
    "prepublishOnly": "bash ../../scripts/prepublish-guard"
  },
  "dependencies": {
    "@noble/hashes": "^1.8.0",
    "@opengeni/contracts": "workspace:*",
    "@opengeni/vaults": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=20"
  }
}
