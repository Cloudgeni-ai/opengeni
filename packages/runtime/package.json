{
  "name": "@opengeni/runtime",
  "version": "1.3.0",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cloudgeni-ai/opengeni.git",
    "directory": "packages/runtime"
  },
  "files": [
    "THIRD_PARTY_NOTICES",
    "dist",
    "src"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./sandbox": {
      "types": "./src/sandbox/index.ts",
      "default": "./src/sandbox/index.ts"
    },
    "./skill-library": {
      "types": "./src/skill-library.ts",
      "default": "./src/skill-library.ts"
    },
    "./mcp-network": {
      "types": "./src/mcp-network.ts",
      "default": "./src/mcp-network.ts"
    },
    "./gmail-rest-mcp": {
      "types": "./src/gmail-rest-mcp.ts",
      "default": "./src/gmail-rest-mcp.ts"
    },
    "./github-rest-mcp": {
      "types": "./src/github-rest-mcp.ts",
      "default": "./src/github-rest-mcp.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "bun ../../scripts/build-typescript-package.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bash ../../scripts/prepublish-guard"
  },
  "dependencies": {
    "@alibaba-group/opensandbox": "0.1.11",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@noble/hashes": "^1.8.0",
    "@openai/agents": "0.14.3",
    "@openai/agents-core": "0.14.3",
    "@openai/agents-extensions": "0.14.3",
    "@opengeni/agent-proto": "workspace:*",
    "@opengeni/capabilities": "workspace:*",
    "@opengeni/codemode": "workspace:*",
    "@opengeni/codex": "workspace:*",
    "@opengeni/config": "workspace:*",
    "@opengeni/contracts": "workspace:*",
    "@opengeni/network": "workspace:*",
    "@opengeni/sdk": "workspace:*",
    "@opengeni/xai-subscription": "workspace:*",
    "debug": "4.4.3",
    "modal": "0.9.0",
    "openai": "6.47.0",
    "ws": "8.21.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "7.0.2"
  }
}
