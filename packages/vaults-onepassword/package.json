{
  "name": "@opengeni/vaults-onepassword",
  "version": "3.1.2",
  "description": "1Password service-account provider for Opengeni vaults. Load it only through dynamic import() from the API and worker: it carries the pinned @1password/sdk WASM core.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cloudgeni-ai/opengeni.git",
    "directory": "packages/vaults-onepassword"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "bun ../../scripts/build-typescript-package.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bash ../../scripts/prepublish-guard"
  },
  "dependencies": {
    "@1password/sdk": "0.5.0",
    "@opengeni/contracts": "workspace:*",
    "@opengeni/vaults": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=18"
  }
}
