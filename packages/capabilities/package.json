{
  "name": "@opengeni/capabilities",
  "version": "0.2.0",
  "description": "Protocol-neutral capability integration compilers and local MCP adapters for OpenGeni.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cloudgeni-ai/opengeni.git",
    "directory": "packages/capabilities"
  },
  "files": [
    "THIRD_PARTY_NOTICES",
    "dist",
    "src",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "bun ../../scripts/build-typescript-package.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bash ../../scripts/prepublish-guard"
  },
  "dependencies": {
    "@openai/agents": "0.14.3",
    "@opengeni/network": "workspace:*",
    "graphql": "^16.12.0",
    "js-yaml": "4.1.1"
  },
  "devDependencies": {
    "@types/js-yaml": "4.0.9",
    "tsup": "^8.5.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=18"
  }
}
