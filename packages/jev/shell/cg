#!/bin/sh
# cg QUESTION PATTERN... [-- PATH...]
# Runs code_grep from the shell through the Codemode client and prints its result text, so a search can be
# chained with other commands in one step (for example `ls && cg 'where is X parsed' parseX -- src`).
# Needs only sh, sed and awk; the relevance judging runs in Opengeni as for the code_grep tool.
if [ "$#" -lt 2 ] || [ "$1" = "-h" ] || [ "$1" = "--help" ]; then
  echo "usage: cg QUESTION PATTERN... [-- PATH...]" >&2
  exit 2
fi
esc() {
  printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e 's/	/\\t/g' | awk 'BEGIN { ORS = "" } NR > 1 { print "\\n" } { print }'
}
question=$(esc "$1")
shift
patterns=""
paths=""
in_paths=0
for arg in "$@"; do
  if [ "$arg" = "--" ] && [ "$in_paths" = 0 ]; then
    in_paths=1
    continue
  fi
  item="\"$(esc "$arg")\""
  if [ "$in_paths" = 0 ]; then patterns="${patterns:+$patterns,}$item"; else paths="${paths:+$paths,}$item"; fi
done
if [ -z "$patterns" ]; then
  echo "cg: give at least one pattern" >&2
  exit 2
fi
json="{\"question\":\"$question\",\"patterns\":[$patterns]${paths:+,\"paths\":[$paths]}}"
if [ -n "${OPENGENI_CODEMODE_NATIVE_CLIENT:-}" ]; then
  set -- "$OPENGENI_CODEMODE_NATIVE_CLIENT" codemode call opengeni.code_grep -
elif command -v ogtool > /dev/null 2>&1; then
  set -- ogtool call opengeni.code_grep -
else
  echo "cg: no Codemode client in this shell (OPENGENI_CODEMODE_NATIVE_CLIENT or ogtool)" >&2
  exit 1
fi
raw=$(printf '%s' "$json" | "$@" 2>&1)
status=$?
printf '%s\n' "$raw" | awk '
function hexval(h,   i, v) { v = 0; for (i = 1; i <= length(h); i++) v = v * 16 + index("0123456789abcdef", tolower(substr(h, i, 1))) - 1; return v }
function utf8(v) {
  if (v < 128) return sprintf("%c", v)
  if (v < 2048) return sprintf("%c%c", 192 + int(v / 64), 128 + v % 64)
  return sprintf("%c%c%c", 224 + int(v / 4096), 128 + int(v / 64) % 64, 128 + v % 64)
}
/^[ \t]*"text": "/ {
  s = $0
  sub(/^[ \t]*"text": "/, "", s)
  sub(/",?[ \t]*$/, "", s)
  out = ""
  while ((k = index(s, "\\")) > 0) {
    out = out substr(s, 1, k - 1)
    d = substr(s, k + 1, 1)
    if (d == "n") { out = out "\n"; s = substr(s, k + 2) }
    else if (d == "t") { out = out "\t"; s = substr(s, k + 2) }
    else if (d == "r") { s = substr(s, k + 2) }
    else if (d == "u") { out = out utf8(hexval(substr(s, k + 2, 4))); s = substr(s, k + 6) }
    else { out = out d; s = substr(s, k + 2) }
  }
  print out s
  found = 1
}
END { if (!found) exit 1 }' || { printf '%s\n' "$raw" >&2; exit 1; }
exit "$status"
