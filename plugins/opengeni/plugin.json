  "author": { "name": "OpenGeni", "url": "https://opengeni.ai" },
  "homepage": "https://docs.opengeni.ai/guides/coding-agents",
  "repository": "https://github.com/Cloudgeni-ai/opengeni",
  "license": "Apache-2.0",
  "keywords": ["opengeni", "mcp", "agents", "background-agents", "cloud-agents", "sdk"],
  "extensions": {
    "com.openai": {
      "interface": { "displayName": "OpenGeni", "shortDescription": "Build and set up OpenGeni" },
      "onboardingSkill": "./skills/opengeni-setup/SKILL.md"
    }
  }
}
